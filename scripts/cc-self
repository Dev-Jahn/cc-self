#!/bin/bash
# ============================================================================
# cc-self — let a Claude Code session control its own TUI
#
# The session's Bash tool runs inside the same tmux pane as the Claude Code
# TUI, so `tmux send-keys` to that pane ($TMUX_PANE) is literally typing into
# the session's own input box. This unlocks user-side slash commands
# (/reload-plugins, /effort, /model, /plugin ...), dialog navigation, and
# even full self-restart.
#
# usage:
#   cc-self type "/reload-plugins"    type text + Enter (default)
#   cc-self type -w "/reload-plugins" ...then queue a wake-up message after it
#                                     (slash commands alone never re-invoke the
#                                     model — chain -w to continue autonomously)
#   cc-self type -n "text"            type without Enter (stage in input box)
#   cc-self type --paste "text"       deliver via bracketed paste instead of
#                                     keystrokes — REQUIRED for long text and
#                                     slash commands with long arguments
#   cc-self type --from-file <path>   paste a file's contents (implies --paste)
#   cc-self key <name>                send one special key (Escape, C-u, Up...)
#   cc-self clear                     empty the input box (backspace burst)
#   cc-self peek [N]                  show last N lines of the pane (default 20)
#   cc-self pane                      show target pane info
#   cc-self sid                       print current session id
#   cc-self restart [sid] [-- flags]  restart own session (delegates a driver
#                                     to the tmux server: waits for turn end,
#                                     /exit, claude --resume with the session's
#                                     model/effort pinned, wake-up message).
#                                     flags after -- are appended to the resume
#                                     command verbatim and win over the pinned
#                                     ones (e.g. -- --effort max)
#   cc-self recover --compact-file <f> [--baseline <model>] [--attempt N]
#                                     deterministic model-fallback recovery:
#                                     wraps the file's instructions into
#                                     /compact "...", pastes + submits it, then
#                                     a detached driver waits out the compaction,
#                                     switches /model back to the baseline,
#                                     approves the confirm dialog only after
#                                     seeing it, verifies the statusline, and
#                                     wakes the session to verify guard silence
#
# target pane priority: --pane <id> > $CC_SELF_PANE > $TMUX_PANE (self)
# every send is logged to $CC_SELF_LOG (default ~/.cc-self.log)
#
# notes:
#  - `type` sends text only. Control keys must go through `key` — prevents
#    accidentally interrupting the session's own turn (Escape) or killing it.
#  - raw keystroke bursts mangle long input: the command palette opened by a
#    leading "/" can swallow same-tick characters, and multibyte (IME) text
#    drops under load — a 3.8KB /compact was observed live mangled into a
#    plain-text message. --paste avoids all of it: the TUI receives a single
#    bracketed-paste event, and the box is verified before Enter.
#  - vim keybindings: when the pane shows `-- NORMAL --`, an `i` is sent
#    first to enter INSERT mode (typing into NORMAL mode gets eaten as vim
#    commands — "cc" is change-line).
#  - slash commands with arguments execute immediately even mid-turn and may
#    open confirmation dialogs: peek first, then `key Enter` deliberately.
# ============================================================================
set -u

LOG="${CC_SELF_LOG:-$HOME/.cc-self.log}"
PANE="${CC_SELF_PANE:-${TMUX_PANE:-}}"

usage() { sed -n '5,43p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
logit() { printf '%s pane=%s %s\n' "$(date '+%F %T')" "$PANE" "$*" >> "$LOG"; }

resolve_sid() {
  if [ -n "${CLAUDE_SESSION_ID:-}" ]; then printf '%s' "$CLAUDE_SESSION_ID"; return; fi
  local d
  d="$HOME/.claude/projects/$(pwd | sed 's|/|-|g')"
  # shellcheck disable=SC2012  # transcript filenames are UUIDs (no spaces/newlines); ls -t sorts by mtime cleanly
  ls -t "$d"/*.jsonl 2>/dev/null | head -1 | sed -E 's|.*/||; s|\.jsonl$||'
}

mode_fix() {  # vim NORMAL mode eats input as commands — enter INSERT first
  if tmux capture-pane -p -t "$PANE" | tail -6 | grep -qE -- '-- NORMAL --|\[NORMAL\]'; then
    tmux send-keys -t "$PANE" -l 'i'
    sleep 0.2
  fi
}

# the input-box line is the last one starting with ❯; the TUI pads a
# no-break space (C2 A0) after ❯ — normalize before matching
input_box() { tmux capture-pane -p -t "$PANE" | tr '\302\240' ' ' | grep '^❯' | tail -1 | sed 's/^❯ *//; s/ *$//'; }

# paste_stage <file>: bracketed-paste a file's contents into the input box and
# verify the box verifiably holds literal text. Does NOT press Enter — the
# caller decides. Sets PASTE_BYTES / PASTE_BOX. Returns 1 without submitting
# anything on failure (never Escape: on self-use the session's own turn is
# running and Escape would interrupt it).
paste_stage() {
  local src="$1" ok=0
  PASTE_BYTES="$(wc -c < "$src" | tr -d ' ')"
  PASTE_BOX=""
  mode_fix
  tmux load-buffer -b cc-self-paste "$src"
  for _ in 1 2 3 4; do
    tmux paste-buffer -p -b cc-self-paste -t "$PANE"
    sleep 1
    PASTE_BOX="$(input_box)"
    [ -z "$PASTE_BOX" ] && continue      # nothing arrived → paste again
    # a large paste collapses to "[Pasted text #N]"; submitting that sends
    # plain text, not a slash command — pasting the same buffer again
    # expands it to literal text (the TUI's "paste again to expand")
    case "$PASTE_BOX" in '[Pasted text #'*) continue ;; esac
    ok=1; break
  done
  tmux delete-buffer -b cc-self-paste 2>/dev/null
  [ "$ok" -eq 1 ]
}

settings_model() {  # the declared baseline model, e.g. claude-fable-5[1m]
  grep -o '"model"[[:space:]]*:[[:space:]]*"[^"]*"' "$HOME/.claude/settings.json" 2>/dev/null | head -1 | cut -d'"' -f4
}

model_label() {
  # model id/arg → statusline label, by normalization (not a fixed table).
  # Rules — keep in lockstep with model_label() in hooks/model-guard.py:
  # strip [..] context suffix → strip claude- prefix → drop -YYYYMMDD date
  # suffix → digit-digit hyphens become dots → hyphens become spaces →
  # capitalize each word. claude-fable-5[1m]→"Fable 5",
  # claude-opus-4-8→"Opus 4.8", claude-haiku-4-5-20251001→"Haiku 4.5".
  local m="${1%%\[*}"
  case "$m" in
    # exceptions normalization cannot produce go here (none known today)
    *) ;;
  esac
  m="${m#claude-}"
  m="$(printf '%s' "$m" | sed -E -e 's/-[0-9]{8}$//' -e ':a' -e 's/([0-9])-([0-9])/\1.\2/' -e 'ta' | tr '-' ' ')"
  printf '%s\n' "$m" | awk '{for(i=1;i<=NF;i++){$i=toupper(substr($i,1,1)) substr($i,2)}}1'
}

# parse --pane anywhere in the arg list
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --pane) PANE="$2"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

[ $# -ge 1 ] || usage
CMD="$1"; shift

case "$CMD" in sid) resolve_sid; echo; exit 0 ;; esac

[ -n "$PANE" ] || { echo "cc-self: cannot determine target pane (not inside tmux?)"; exit 1; }
tmux has-session 2>/dev/null || { echo "cc-self: no tmux server"; exit 1; }

case "$CMD" in
  pane)
    tmux display-message -p -t "$PANE" \
      '#{pane_id} #{session_name}:#{window_index}.#{pane_index} cmd=#{pane_current_command} title=#{pane_title}'
    ;;
  peek)
    N="${1:-20}"
    tmux capture-pane -p -t "$PANE" | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' | tail -n "$N"
    ;;
  type)
    NO_ENTER=0; WAKE=0; PASTE=0; FROM=""
    while :; do
      case "${1:-}" in
        -n) NO_ENTER=1; shift ;;
        -w|--wake) WAKE=1; shift ;;
        --paste) PASTE=1; shift ;;
        --from-file)
          [ -n "${2:-}" ] || { echo "cc-self type: --from-file needs a path"; exit 1; }
          FROM="$2"; PASTE=1; shift 2 ;;
        *) break ;;
      esac
    done
    TEXT=""
    if [ -n "$FROM" ]; then
      [ -f "$FROM" ] || { echo "cc-self type: no such file: $FROM"; exit 1; }
    else
      [ $# -ge 1 ] || { echo "cc-self type: nothing to send"; exit 1; }
      TEXT="$*"
    fi
    if [ "$PASTE" -eq 1 ]; then
      # Bracketed paste: the TUI receives the text as one paste event, so
      # nothing is interpreted per-keystroke — no command-palette race on a
      # leading "/", no multibyte drops in long bursts.
      SRC="$FROM"; TMP=""
      if [ -z "$SRC" ]; then
        TMP="$(mktemp "${TMPDIR:-/tmp}/cc-self-paste.XXXXXX")"
        printf '%s' "$TEXT" > "$TMP"
        SRC="$TMP"
      fi
      OK=0; paste_stage "$SRC" && OK=1
      BYTES="$PASTE_BYTES"
      [ -n "$TMP" ] && rm -f "$TMP"
      if [ "$OK" -ne 1 ]; then
        # abort without Enter and without clearing: on self-use the session's
        # own turn is running, and Escape would interrupt it — peek, then
        # recover deliberately (a collapsed placeholder deletes with BSpace)
        logit "type (paste) FAIL: box did not reach literal state (box: ${PASTE_BOX:-empty})"
        echo "cc-self type: paste did not verify (box: ${PASTE_BOX:-empty}) — nothing submitted; peek and recover" >&2
        exit 1
      fi
      DESC="paste ${BYTES}B${FROM:+ from $FROM}"
    else
      mode_fix
      tmux send-keys -t "$PANE" -l -- "$TEXT"
      sleep 0.3   # let the TUI process input (autocomplete popup etc.)
      DESC="$TEXT"
    fi
    [ "$NO_ENTER" -eq 0 ] && tmux send-keys -t "$PANE" Enter
    if [ "$WAKE" -eq 1 ]; then
      # Slash commands execute locally and never start a model turn. A plain
      # message CANNOT simply be queued behind them: mid-turn, the TUI injects
      # queued plain text into the RUNNING turn while slash commands stay
      # queued — the wake would be consumed before the command runs. So the
      # wake is typed by a detached waker (tmux server process) that waits for
      # the turn to end and queued commands to drain first.
      TMUX_BIN="$(command -v tmux)"
      WAKER="$HOME/.cc-self-waker.sh"
      cat > "$WAKER" <<'WKR'
#!/bin/bash
PANE="$1"; NOTE="$2"; TMUX_BIN="$3"
log() { printf '%s [waker] %s\n' "$(date '+%F %T')" "$*"; }
log "armed pane=$PANE"
sleep 5
idle=0
for _ in $(seq 1 90); do   # wait for the running turn to end (max 3 min)
  if "$TMUX_BIN" capture-pane -p -t "$PANE" | grep -q 'to interrupt'; then idle=0; else idle=$((idle+1)); fi
  [ "$idle" -ge 3 ] && break
  sleep 2
done
sleep 2                    # let queued slash commands drain
"$TMUX_BIN" capture-pane -p -t "$PANE" | tail -6 | grep -qE -- '-- NORMAL --' \
  && { "$TMUX_BIN" send-keys -t "$PANE" -l 'i'; sleep 0.3; }
"$TMUX_BIN" send-keys -t "$PANE" -l -- "[cc-self wake] continue after: $NOTE"
sleep 0.5
"$TMUX_BIN" send-keys -t "$PANE" Enter
log "wake sent"
WKR
      chmod +x "$WAKER"
      # the waker re-types the note as raw keystrokes — for pastes, pass a
      # short summary instead of the (possibly huge) text itself
      NOTE="$TEXT"
      [ "$PASTE" -eq 1 ] && NOTE="pasted input (${BYTES} bytes)"
      tmux run-shell -b "/bin/bash '$WAKER' '$PANE' '$NOTE' '$TMUX_BIN' >> '$LOG' 2>&1"
    fi
    logit "type$([ $NO_ENTER -eq 1 ] && echo ' (no-enter)')$([ $WAKE -eq 1 ] && echo ' (+wake)'): $DESC"
    echo "sent to $PANE: $DESC$([ $NO_ENTER -eq 1 ] && echo ' (no Enter)')$([ $WAKE -eq 1 ] && echo ' (+wake queued)')"
    ;;
  key)
    [ $# -ge 1 ] || { echo "cc-self key: key name required (e.g. Escape, C-u, Up)"; exit 1; }
    tmux send-keys -t "$PANE" "$1"
    logit "key: $1"
    echo "sent key to $PANE: $1"
    ;;
  clear)
    tmux send-keys -N 80 -t "$PANE" BSpace
    logit "clear"
    echo "cleared input of $PANE"
    ;;
  recover)
    # Deterministic model-fallback recovery (compact-first: a bare /model
    # switch does not hold while the trigger content is still in context).
    # The model's ONLY job is writing the compact instruction file; everything
    # else — submitting /compact, waiting out the compaction, switching /model
    # back, approving the dialog after seeing it, verifying the statusline,
    # waking the session — is done mechanically by a detached driver.
    # See skills/model-recovery/SKILL.md.
    COMPACT_FILE=""; BASELINE=""; ATTEMPT=1
    while :; do
      case "${1:-}" in
        --compact-file) [ -n "${2:-}" ] || { echo "cc-self recover: --compact-file needs a path"; exit 1; }
                        COMPACT_FILE="$2"; shift 2 ;;
        --baseline)     [ -n "${2:-}" ] || { echo "cc-self recover: --baseline needs a model"; exit 1; }
                        BASELINE="$2"; shift 2 ;;
        --attempt)      [ -n "${2:-}" ] || { echo "cc-self recover: --attempt needs a number"; exit 1; }
                        ATTEMPT="$2"; shift 2 ;;
        *) break ;;
      esac
    done
    [ -n "$COMPACT_FILE" ] || { echo "cc-self recover: --compact-file <path> is required (instructions only — no /compact prefix)"; exit 1; }
    [ -f "$COMPACT_FILE" ] || { echo "cc-self recover: no such file: $COMPACT_FILE"; exit 1; }
    case "$ATTEMPT" in ''|*[!0-9]*) echo "cc-self recover: --attempt must be a number"; exit 1 ;; esac
    [ -n "$BASELINE" ] || BASELINE="$(settings_model)"
    [ -n "$BASELINE" ] || { echo "cc-self recover: cannot resolve baseline (no --baseline, no model in settings.json)"; exit 1; }
    LABEL="$(model_label "$BASELINE")"
    SID="$(resolve_sid)"
    [ -n "$SID" ] || { echo "cc-self recover: cannot resolve session id"; exit 1; }
    STATE_DIR="$HOME/.cc-self/state"     # state is strictly PER-SESSION (keyed by sid)
    mkdir -p "$STATE_DIR"
    # age-based GC: recover states of long-gone sessions, stale yield flags
    find "$STATE_DIR" -name 'recover-*.json' -mtime +7 -delete 2>/dev/null
    find "$STATE_DIR" -name 'yield-*' -mtime +1 -delete 2>/dev/null
    STATE="$STATE_DIR/recover-$SID.json"
    rc_state() {  # rc_state <phase> [note] — note may quote screen content; keep the JSON valid
      local n; n="$(printf '%s' "${2:-}" | tr '\042\134' '\047 ')"
      printf '{"sid":"%s","pane":"%s","baseline":"%s","label":"%s","attempt":%s,"phase":"%s","note":"%s","ts":"%s"}\n' \
        "$SID" "$PANE" "$BASELINE" "$LABEL" "$ATTEMPT" "$1" "$n" "$(date '+%FT%T%z')" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
    }
    rc_state ARMED
    # Wrap the instructions into /compact "...". Double quotes inside the
    # instructions would fight the wrapping quotes — normalize to single.
    TMPC="$(mktemp "${TMPDIR:-/tmp}/cc-self-recover.XXXXXX")"
    INSTR="$(sed "s/\"/'/g" "$COMPACT_FILE")"
    printf '/compact "%s"' "$INSTR" > "$TMPC"
    if ! paste_stage "$TMPC"; then
      rm -f "$TMPC"
      rc_state FAILED-COMPACT_STAGE "paste did not verify (box: ${PASTE_BOX:-empty})"
      logit "recover FAIL: compact paste did not verify (box: ${PASTE_BOX:-empty})"
      echo "cc-self recover: compact paste did not verify — nothing submitted; peek and recover" >&2
      exit 1
    fi
    rm -f "$TMPC"
    tmux send-keys -t "$PANE" Enter      # mid-turn: /compact queues, drains at idle
    rc_state COMPACT_SUBMITTED
    TMUX_BIN="$(command -v tmux)"
    RDRIVER="$HOME/.cc-self-recover-driver.sh"
    cat > "$RDRIVER" <<'RCV'
#!/bin/bash
# cc-self recover driver — runs detached under the tmux server.
# Phases: ARMED → COMPACT_SUBMITTED → COMPACT_DONE → MODEL_DIALOG → SWITCHED
#         → VERIFY_WAKE → DONE, or FAILED-<phase> (no blind keypress, ever).
PANE="$1"; SID="$2"; BASELINE="$3"; LABEL="$4"; ATTEMPT="$5"; TMUX_BIN="$6"; STATE="$7"
STATE_DIR="$(dirname "$STATE")"; YIELD="$STATE_DIR/yield-$SID"
log()  { printf '%s [recover-driver] %s\n' "$(date '+%F %T')" "$*"; }
norm() { "$TMUX_BIN" capture-pane -p -t "$PANE" 2>/dev/null | tr '\302\240' ' '; }
fg()   { "$TMUX_BIN" display-message -p -t "$PANE" '#{pane_current_command}' 2>/dev/null; }
set_state() {  # set_state <phase> [note] — note may quote screen content; keep the JSON valid
  local n; n="$(printf '%s' "${2:-}" | tr '\042\134' '\047 ')"
  printf '{"sid":"%s","pane":"%s","baseline":"%s","label":"%s","attempt":%s,"phase":"%s","note":"%s","ts":"%s"}\n' \
    "$SID" "$PANE" "$BASELINE" "$LABEL" "$ATTEMPT" "$1" "$n" "$(date '+%FT%T%z')" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}
fail() { log "FAIL $1${2:+: $2}"; set_state "FAILED-$1" "${2:-}"; rm -f "$YIELD"; exit 1; }
alive() {  # pane must exist and still run the TUI (a plain shell = session gone)
  norm >/dev/null || fail "$1" "pane gone (capture failed)"
  case "$(fg)" in ''|zsh|bash|fish|sh) fail "$1" "TUI not foreground (fg=$(fg))" ;; esac
}
mode_fix() { norm | tail -6 | grep -qE -- '-- NORMAL --' && { "$TMUX_BIN" send-keys -t "$PANE" -l 'i'; sleep 0.3; }; }
box() { norm | grep '^❯' | tail -1 | sed 's/^❯ *//; s/ *$//'; }

log "armed pane=$PANE sid=$SID baseline=$BASELINE label=${LABEL:-(none)} attempt=$ATTEMPT"
# yield-valve: a session whose Stop hook always blocks never goes idle, so the
# queued /compact would never drain. Contract: the driver raises this flag; a
# cooperating Stop hook sees it, deletes it, and lets ONE stop through.
touch "$YIELD"

# ---- wait for the running turn to end AND the compaction to finish --------
# The running turn and the compaction spinner both render a "... to interrupt"
# hint near the bottom; compaction additionally shows "Compacting". Quiet =
# neither marker in the bottom window for 3 consecutive polls. The queued
# /compact drains within a tick of turn end, so the gap between the two busy
# phases cannot produce 3 quiet polls (6s). The window is tail -15 on purpose:
# conversation text higher up may legitimately CONTAIN these words.
sleep 5
quiet=0
for _ in $(seq 1 300); do   # up to 10 min — compaction of a large context is slow
  if norm | tail -15 | grep -qE 'to interrupt|Compacting'; then quiet=0; else quiet=$((quiet+1)); fi
  [ "$quiet" -ge 3 ] && break
  sleep 2
done
[ "$quiet" -ge 3 ] || fail COMPACT_DONE "turn/compaction still busy after 10 min"
alive COMPACT_DONE
set_state COMPACT_DONE
log "compaction finished → staging /model"

# ---- stage + submit /model <baseline> (opens a confirm dialog) ------------
# Staged via bracketed paste (single event — the command palette opened by the
# leading "/" cannot swallow same-tick characters), verified, then submitted.
CMD="/model $BASELINE"
staged=0
for i in 1 2 3; do
  mode_fix
  f="$(mktemp "${TMPDIR:-/tmp}/cc-self-rcv.XXXXXX")"
  printf '%s' "$CMD" > "$f"
  "$TMUX_BIN" load-buffer -b cc-self-rcv "$f"
  rm -f "$f"
  "$TMUX_BIN" paste-buffer -p -b cc-self-rcv -t "$PANE"
  "$TMUX_BIN" delete-buffer -b cc-self-rcv 2>/dev/null
  sleep 1
  [ "$(box)" = "$CMD" ] && { staged=1; break; }
  log "stage attempt $i: box holds '$(box)' — clearing and retrying"
  "$TMUX_BIN" send-keys -N 80 -t "$PANE" BSpace   # idle here: BSpace is safe, Escape is not
  sleep 0.5
done
[ "$staged" -eq 1 ] || fail MODEL_DIALOG "could not stage $CMD in the input box"
"$TMUX_BIN" send-keys -t "$PANE" Enter
set_state MODEL_DIALOG

# never press blind: approve only after SEEING the dialog with the expected
# option highlighted
seen=0
for _ in $(seq 1 15); do
  s="$(norm)"
  if printf '%s\n' "$s" | grep -q 'Switch model?'; then
    seen=1
    printf '%s\n' "$s" | grep -qE '❯ *1\. Yes, switch to' && { seen=2; break; }
  fi
  sleep 1
done
if [ "$seen" -ne 2 ]; then
  if [ "$seen" -eq 1 ]; then
    "$TMUX_BIN" send-keys -t "$PANE" Escape   # a dialog IS confirmed open — Escape only cancels it
    fail MODEL_DIALOG "dialog open but 'Yes, switch to' not highlighted"
  fi
  fail MODEL_DIALOG "Switch model dialog never appeared"
fi
"$TMUX_BIN" send-keys -t "$PANE" Enter

# ---- verify the switch took: statusline label or confirmation toast -------
# Bottom window only — post-compact conversation text may contain "[Label]".
ok=0
for _ in $(seq 1 30); do
  s="$(norm | tail -8)"
  if [ -n "$LABEL" ] && printf '%s\n' "$s" | grep -qF "[$LABEL]"; then ok=1; break; fi
  printf '%s\n' "$s" | grep -q 'Set model to' && { ok=1; break; }
  sleep 1
done
[ "$ok" -eq 1 ] || fail SWITCHED "statusline/toast did not confirm the switch"
set_state SWITCHED
log "switched to $BASELINE"

# ---- wake the session so the guard hook can confirm the recovery held -----
alive VERIFY_WAKE
set_state VERIFY_WAKE
sleep 2
mode_fix
"$TMUX_BIN" send-keys -t "$PANE" -l -- "[cc-self recover] attempt $ATTEMPT: model switched, verify guard silence and report"
sleep 0.5
"$TMUX_BIN" send-keys -t "$PANE" Enter
set_state DONE
rm -f "$YIELD"
log "done — verification wake sent"
RCV
    chmod +x "$RDRIVER"
    tmux run-shell -b "/bin/bash '$RDRIVER' '$PANE' '$SID' '$BASELINE' '$LABEL' '$ATTEMPT' '$TMUX_BIN' '$STATE' >> '$LOG' 2>&1"
    logit "recover: armed sid=$SID baseline=$BASELINE label=${LABEL:-?} attempt=$ATTEMPT compact=${PASTE_BYTES}B"
    echo "recover armed (attempt $ATTEMPT): /compact queued (${PASTE_BYTES}B) — end the turn now; driver: compaction → /model $BASELINE → dialog → verify → wake (state: $STATE, log: $LOG)"
    ;;
  restart)
    # The session's own death kills its Bash tool too, so the restart
    # sequence is delegated to a process owned by the tmux server
    # (run-shell -b), which outlives the session.
    SID=""
    if [ $# -ge 1 ] && [ "$1" != "--" ]; then SID="$1"; shift; fi
    [ -n "$SID" ] || SID="$(resolve_sid)"
    [ -n "$SID" ] || { echo "cc-self restart: cannot resolve session id (pass it explicitly)"; exit 1; }
    EXTRA=""
    if [ "${1:-}" = "--" ]; then shift; EXTRA="$*"; fi
    CLAUDE_BIN="${CC_SELF_CLAUDE_BIN:-}"
    if [ -z "$CLAUDE_BIN" ]; then
      CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"
      case "$CLAUDE_BIN" in ''|alias*) CLAUDE_BIN="$HOME/.local/bin/claude" ;; esac
    fi
    [ -x "$CLAUDE_BIN" ] || { echo "cc-self restart: claude binary not found: $CLAUDE_BIN"; exit 1; }
    # Capture the session's model + effort while it is still alive: a bare
    # --resume falls back to defaults, so an effort changed mid-session is
    # lost and the changed system prompt breaks the warm prompt cache.
    # Freshest source is the transcript's last main-chain assistant entry
    # (real JSON keys are unescaped there; quotes inside message text are
    # \"-escaped, so these greps can't match prose). Fallback: settings.json.
    TRANSCRIPT="$HOME/.claude/projects/$(pwd | sed 's|/|-|g')/$SID.jsonl"
    if [ ! -f "$TRANSCRIPT" ]; then
      # the session's cwd may have moved since launch — find the sid anywhere
      # shellcheck disable=SC2012  # sid is a UUID; glob yields at most one clean path
      TRANSCRIPT="$(ls "$HOME"/.claude/projects/*/"$SID".jsonl 2>/dev/null | head -1)"
    fi
    MODEL=""; EFFORT=""
    if [ -n "$TRANSCRIPT" ] && [ -f "$TRANSCRIPT" ]; then
      ALINE="$(grep '"type":"assistant"' "$TRANSCRIPT" | grep -v '"isSidechain":true' | grep '"effort":"' | tail -1)"
      MODEL="$(printf '%s' "$ALINE" | grep -o '"model":"[^"]*"' | head -1 | cut -d'"' -f4)"
      EFFORT="$(printf '%s' "$ALINE" | grep -o '"effort":"[a-z]*"' | head -1 | cut -d'"' -f4)"
    fi
    SETTINGS="$HOME/.claude/settings.json"
    SMODEL="$(settings_model)"
    # transcripts record the bare API model id; settings may name a suffixed
    # variant of the same model (e.g. claude-fable-5[1m] for 1M context).
    # Adopt the suffixed form when the base matches so the mode survives.
    if [ -n "$MODEL" ] && [ "${SMODEL%%\[*}" = "$MODEL" ]; then MODEL="$SMODEL"; fi
    [ -n "$MODEL" ]  || MODEL="$SMODEL"
    [ -n "$EFFORT" ] || EFFORT="$(grep -o '"effortLevel"[[:space:]]*:[[:space:]]*"[^"]*"' "$SETTINGS" 2>/dev/null | head -1 | cut -d'"' -f4)"
    TMUX_BIN="$(command -v tmux)"
    DRIVER="$HOME/.cc-self-restart-driver.sh"
    cat > "$DRIVER" <<'DRV'
#!/bin/bash
# cc-self restart driver — runs detached under the tmux server
PANE="$1"; SID="$2"; BIN="$3"; TMUX_BIN="$4"; MODEL="$5"; EFFORT="$6"; EXTRA="$7"
log() { printf '%s [restart-driver] %s\n' "$(date '+%F %T')" "$*"; }
fg()  { "$TMUX_BIN" display-message -p -t "$PANE" '#{pane_current_command}'; }
mode_fix() {  # vim NORMAL mode → INSERT
  "$TMUX_BIN" capture-pane -p -t "$PANE" | tail -6 | grep -qE -- '-- NORMAL --' \
    && { "$TMUX_BIN" send-keys -t "$PANE" -l 'i'; sleep 0.3; }
}
tui_type() { mode_fix; "$TMUX_BIN" send-keys -t "$PANE" -l -- "$1"; sleep 0.5; "$TMUX_BIN" send-keys -t "$PANE" Enter; }
# At idle the leading "/" opens the command palette, and characters that
# arrive in the same input tick can be swallowed by its initialization
# (observed live: only the trailing "t" of /exit survived and Enter
# submitted it as a user message). Stage the command in two paced sends
# and press Enter only after the input box visibly holds /exit.
type_exit() {
  for attempt in 1 2 3; do
    mode_fix
    "$TMUX_BIN" send-keys -t "$PANE" -l '/'
    sleep 0.6
    "$TMUX_BIN" send-keys -t "$PANE" -l 'exit'
    sleep 0.6
    # capture-pane pads to full pane height with blank lines, so strip them
    # before windowing; the TUI also renders a no-break space (C2 A0) after
    # the ❯ prompt — normalize it to plain spaces before matching
    if "$TMUX_BIN" capture-pane -p -t "$PANE" | sed '/^[[:space:]]*$/d' | tail -10 | tr '\302\240' '  ' | grep -qE '[>❯] */exit'; then
      "$TMUX_BIN" send-keys -t "$PANE" Enter
      return 0
    fi
    log "stage attempt $attempt: /exit not in input box → clear and retry"
    "$TMUX_BIN" send-keys -t "$PANE" Escape
    sleep 0.3
    for _ in $(seq 1 8); do "$TMUX_BIN" send-keys -t "$PANE" BSpace; done
    sleep 0.5
  done
  log "FAIL: could not stage /exit after 3 attempts — aborting, session left intact"
  return 1
}

log "start pane=$PANE sid=$SID"
sleep 15                              # let the session finish its last message
idle=0
for _ in $(seq 1 60); do              # wait for turn streaming to end (max 2 min)
  if "$TMUX_BIN" capture-pane -p -t "$PANE" | grep -q 'to interrupt'; then idle=0; else idle=$((idle+1)); fi
  [ "$idle" -ge 3 ] && break
  sleep 2
done
# preserve session state across the relaunch: pin the model + effort captured
# at arm time (a bare --resume falls back to defaults — effort resets and the
# changed system prompt breaks the warm prompt cache), keep the bypass flag
# only if the footer showed it on, and append caller extras. An extra that
# names --model/--effort itself replaces the pinned one (pin is dropped).
# Every typed value is single-quoted: the command lands in the pane's live
# shell, where an unquoted claude-fable-5[1m] is a zsh glob ("no matches
# found" — the relaunch never runs).
case " $EXTRA" in *" --model"*)  MODEL=""  ;; esac
case " $EXTRA" in *" --effort"*) EFFORT="" ;; esac
FLAGS=""
[ -n "$MODEL" ]  && FLAGS="$FLAGS --model '$MODEL'"
[ -n "$EFFORT" ] && FLAGS="$FLAGS --effort '$EFFORT'"
"$TMUX_BIN" capture-pane -p -t "$PANE" | grep -q 'bypass permissions on' && FLAGS="$FLAGS --dangerously-skip-permissions"
if [ -n "$EXTRA" ]; then
  read -ra EXTRA_WORDS <<< "$EXTRA"
  for w in "${EXTRA_WORDS[@]}"; do FLAGS="$FLAGS '$w'"; done
fi
log "turn idle → sending /exit (resume flags:${FLAGS:- none})"
type_exit || exit 1
# /exit with live background tasks opens a "Background work is running"
# confirm dialog instead of exiting — Enter takes the preselected
# "Exit and stop tasks" (restart kills background work by contract).
for _ in $(seq 1 90); do
  case "$(fg)" in zsh|bash|fish|sh) break ;; esac
  if "$TMUX_BIN" capture-pane -p -t "$PANE" | grep -q 'Background work is running'; then
    log "background-work dialog → confirming (exit and stop tasks)"
    "$TMUX_BIN" send-keys -t "$PANE" Enter
  fi
  sleep 1
done
case "$(fg)" in zsh|bash|fish|sh) ;; *) log "FAIL: claude did not exit (fg=$(fg))"; exit 1 ;; esac
log "claude exited → relaunching (real binary, alias bypassed)"
sleep 1
"$TMUX_BIN" send-keys -t "$PANE" -l -- "$BIN --resume $SID$FLAGS"
sleep 0.5
"$TMUX_BIN" send-keys -t "$PANE" Enter
for _ in $(seq 1 60); do case "$(fg)" in zsh|bash|fish|sh) sleep 1 ;; *) break ;; esac; done
case "$(fg)" in zsh|bash|fish|sh) log "FAIL: claude did not come back"; exit 1 ;; esac
log "claude relaunched → waiting for session load"
sleep 12
tui_type '[cc-self restart driver] Automated restart sequence complete. Verify session continuity and report the result to the user.'
log "wake-up message sent — driver done"
DRV
    chmod +x "$DRIVER"
    tmux run-shell -b "/bin/bash '$DRIVER' '$PANE' '$SID' '$CLAUDE_BIN' '$TMUX_BIN' '$MODEL' '$EFFORT' '$EXTRA' >> '$LOG' 2>&1"
    logit "restart: sid=$SID bin=$CLAUDE_BIN model=${MODEL:-?} effort=${EFFORT:-?}${EXTRA:+ extra=$EXTRA}"
    echo "restart driver armed — after this turn ends: /exit → resume pinning model=${MODEL:-default} effort=${EFFORT:-default}${EXTRA:+ + $EXTRA} (log: $LOG)"
    ;;
  *)
    usage
    ;;
esac
