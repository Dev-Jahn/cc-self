#!/bin/bash
# ============================================================================
# cc-self — let a Claude Code session control its own TUI
#
# The session's Bash tool runs inside the same tmux pane as the Claude Code
# TUI, so `tmux send-keys` to that pane ($TMUX_PANE) is literally typing into
# the session's own input box. This unlocks user-side slash commands
# (/reload-plugins, /effort, /model, /plugin ...), dialog navigation, and
# even full self-restart.
#
# usage:
#   cc-self type "/reload-plugins"    type text + Enter (default)
#   cc-self type -w "/reload-plugins" ...then queue a wake-up message after it
#                                     (slash commands alone never re-invoke the
#                                     model — chain -w to continue autonomously)
#   cc-self type -n "text"            type without Enter (stage in input box)
#   cc-self key <name>                send one special key (Escape, C-u, Up...)
#   cc-self clear                     empty the input box (backspace burst)
#   cc-self peek [N]                  show last N lines of the pane (default 20)
#   cc-self pane                      show target pane info
#   cc-self sid                       print current session id
#   cc-self restart [sid] [-- flags]  restart own session (delegates a driver
#                                     to the tmux server: waits for turn end,
#                                     /exit, claude --resume with the session's
#                                     model/effort pinned, wake-up message).
#                                     flags after -- are appended to the resume
#                                     command verbatim and win over the pinned
#                                     ones (e.g. -- --effort max)
#
# target pane priority: --pane <id> > $CC_SELF_PANE > $TMUX_PANE (self)
# every send is logged to $CC_SELF_LOG (default ~/.cc-self.log)
#
# notes:
#  - `type` sends text only. Control keys must go through `key` — prevents
#    accidentally interrupting the session's own turn (Escape) or killing it.
#  - vim keybindings: when the pane shows `-- NORMAL --`, an `i` is sent
#    first to enter INSERT mode (typing into NORMAL mode gets eaten as vim
#    commands — "cc" is change-line).
#  - slash commands with arguments execute immediately even mid-turn and may
#    open confirmation dialogs: peek first, then `key Enter` deliberately.
# ============================================================================
set -u

LOG="${CC_SELF_LOG:-$HOME/.cc-self.log}"
PANE="${CC_SELF_PANE:-${TMUX_PANE:-}}"

usage() { sed -n '5,30p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
logit() { printf '%s pane=%s %s\n' "$(date '+%F %T')" "$PANE" "$*" >> "$LOG"; }

resolve_sid() {
  if [ -n "${CLAUDE_SESSION_ID:-}" ]; then printf '%s' "$CLAUDE_SESSION_ID"; return; fi
  local d
  d="$HOME/.claude/projects/$(pwd | sed 's|/|-|g')"
  # shellcheck disable=SC2012  # transcript filenames are UUIDs (no spaces/newlines); ls -t sorts by mtime cleanly
  ls -t "$d"/*.jsonl 2>/dev/null | head -1 | sed -E 's|.*/||; s|\.jsonl$||'
}

# parse --pane anywhere in the arg list
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --pane) PANE="$2"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

[ $# -ge 1 ] || usage
CMD="$1"; shift

case "$CMD" in sid) resolve_sid; echo; exit 0 ;; esac

[ -n "$PANE" ] || { echo "cc-self: cannot determine target pane (not inside tmux?)"; exit 1; }
tmux has-session 2>/dev/null || { echo "cc-self: no tmux server"; exit 1; }

case "$CMD" in
  pane)
    tmux display-message -p -t "$PANE" \
      '#{pane_id} #{session_name}:#{window_index}.#{pane_index} cmd=#{pane_current_command} title=#{pane_title}'
    ;;
  peek)
    N="${1:-20}"
    tmux capture-pane -p -t "$PANE" | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' | tail -n "$N"
    ;;
  type)
    NO_ENTER=0; WAKE=0
    while :; do
      case "${1:-}" in
        -n) NO_ENTER=1; shift ;;
        -w|--wake) WAKE=1; shift ;;
        *) break ;;
      esac
    done
    [ $# -ge 1 ] || { echo "cc-self type: nothing to send"; exit 1; }
    TEXT="$*"
    send_line() {  # type one line, entering INSERT first if vim NORMAL mode
      if tmux capture-pane -p -t "$PANE" | tail -6 | grep -qE -- '-- NORMAL --|\[NORMAL\]'; then
        tmux send-keys -t "$PANE" -l 'i'
        sleep 0.2
      fi
      tmux send-keys -t "$PANE" -l -- "$1"
      sleep 0.3   # let the TUI process input (autocomplete popup etc.)
    }
    send_line "$TEXT"
    [ "$NO_ENTER" -eq 0 ] && tmux send-keys -t "$PANE" Enter
    if [ "$WAKE" -eq 1 ]; then
      # Slash commands execute locally and never start a model turn. A plain
      # message CANNOT simply be queued behind them: mid-turn, the TUI injects
      # queued plain text into the RUNNING turn while slash commands stay
      # queued — the wake would be consumed before the command runs. So the
      # wake is typed by a detached waker (tmux server process) that waits for
      # the turn to end and queued commands to drain first.
      TMUX_BIN="$(command -v tmux)"
      WAKER="$HOME/.cc-self-waker.sh"
      cat > "$WAKER" <<'WKR'
#!/bin/bash
PANE="$1"; NOTE="$2"; TMUX_BIN="$3"
log() { printf '%s [waker] %s\n' "$(date '+%F %T')" "$*"; }
log "armed pane=$PANE"
sleep 5
idle=0
for _ in $(seq 1 90); do   # wait for the running turn to end (max 3 min)
  if "$TMUX_BIN" capture-pane -p -t "$PANE" | grep -q 'to interrupt'; then idle=0; else idle=$((idle+1)); fi
  [ "$idle" -ge 3 ] && break
  sleep 2
done
sleep 2                    # let queued slash commands drain
"$TMUX_BIN" capture-pane -p -t "$PANE" | tail -6 | grep -qE -- '-- NORMAL --' \
  && { "$TMUX_BIN" send-keys -t "$PANE" -l 'i'; sleep 0.3; }
"$TMUX_BIN" send-keys -t "$PANE" -l -- "[cc-self wake] continue after: $NOTE"
sleep 0.5
"$TMUX_BIN" send-keys -t "$PANE" Enter
log "wake sent"
WKR
      chmod +x "$WAKER"
      tmux run-shell -b "/bin/bash '$WAKER' '$PANE' '$TEXT' '$TMUX_BIN' >> '$LOG' 2>&1"
    fi
    logit "type$([ $NO_ENTER -eq 1 ] && echo ' (no-enter)')$([ $WAKE -eq 1 ] && echo ' (+wake)'): $TEXT"
    echo "sent to $PANE: $TEXT$([ $NO_ENTER -eq 1 ] && echo ' (no Enter)')$([ $WAKE -eq 1 ] && echo ' (+wake queued)')"
    ;;
  key)
    [ $# -ge 1 ] || { echo "cc-self key: key name required (e.g. Escape, C-u, Up)"; exit 1; }
    tmux send-keys -t "$PANE" "$1"
    logit "key: $1"
    echo "sent key to $PANE: $1"
    ;;
  clear)
    tmux send-keys -N 80 -t "$PANE" BSpace
    logit "clear"
    echo "cleared input of $PANE"
    ;;
  restart)
    # The session's own death kills its Bash tool too, so the restart
    # sequence is delegated to a process owned by the tmux server
    # (run-shell -b), which outlives the session.
    SID=""
    if [ $# -ge 1 ] && [ "$1" != "--" ]; then SID="$1"; shift; fi
    [ -n "$SID" ] || SID="$(resolve_sid)"
    [ -n "$SID" ] || { echo "cc-self restart: cannot resolve session id (pass it explicitly)"; exit 1; }
    EXTRA=""
    if [ "${1:-}" = "--" ]; then shift; EXTRA="$*"; fi
    CLAUDE_BIN="${CC_SELF_CLAUDE_BIN:-}"
    if [ -z "$CLAUDE_BIN" ]; then
      CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"
      case "$CLAUDE_BIN" in ''|alias*) CLAUDE_BIN="$HOME/.local/bin/claude" ;; esac
    fi
    [ -x "$CLAUDE_BIN" ] || { echo "cc-self restart: claude binary not found: $CLAUDE_BIN"; exit 1; }
    # Capture the session's model + effort while it is still alive: a bare
    # --resume falls back to defaults, so an effort changed mid-session is
    # lost and the changed system prompt breaks the warm prompt cache.
    # Freshest source is the transcript's last main-chain assistant entry
    # (real JSON keys are unescaped there; quotes inside message text are
    # \"-escaped, so these greps can't match prose). Fallback: settings.json.
    TRANSCRIPT="$HOME/.claude/projects/$(pwd | sed 's|/|-|g')/$SID.jsonl"
    if [ ! -f "$TRANSCRIPT" ]; then
      # the session's cwd may have moved since launch — find the sid anywhere
      # shellcheck disable=SC2012  # sid is a UUID; glob yields at most one clean path
      TRANSCRIPT="$(ls "$HOME"/.claude/projects/*/"$SID".jsonl 2>/dev/null | head -1)"
    fi
    MODEL=""; EFFORT=""
    if [ -n "$TRANSCRIPT" ] && [ -f "$TRANSCRIPT" ]; then
      ALINE="$(grep '"type":"assistant"' "$TRANSCRIPT" | grep -v '"isSidechain":true' | grep '"effort":"' | tail -1)"
      MODEL="$(printf '%s' "$ALINE" | grep -o '"model":"[^"]*"' | head -1 | cut -d'"' -f4)"
      EFFORT="$(printf '%s' "$ALINE" | grep -o '"effort":"[a-z]*"' | head -1 | cut -d'"' -f4)"
    fi
    SETTINGS="$HOME/.claude/settings.json"
    SMODEL="$(grep -o '"model"[[:space:]]*:[[:space:]]*"[^"]*"' "$SETTINGS" 2>/dev/null | head -1 | cut -d'"' -f4)"
    # transcripts record the bare API model id; settings may name a suffixed
    # variant of the same model (e.g. claude-fable-5[1m] for 1M context).
    # Adopt the suffixed form when the base matches so the mode survives.
    if [ -n "$MODEL" ] && [ "${SMODEL%%\[*}" = "$MODEL" ]; then MODEL="$SMODEL"; fi
    [ -n "$MODEL" ]  || MODEL="$SMODEL"
    [ -n "$EFFORT" ] || EFFORT="$(grep -o '"effortLevel"[[:space:]]*:[[:space:]]*"[^"]*"' "$SETTINGS" 2>/dev/null | head -1 | cut -d'"' -f4)"
    TMUX_BIN="$(command -v tmux)"
    DRIVER="$HOME/.cc-self-restart-driver.sh"
    cat > "$DRIVER" <<'DRV'
#!/bin/bash
# cc-self restart driver — runs detached under the tmux server
PANE="$1"; SID="$2"; BIN="$3"; TMUX_BIN="$4"; MODEL="$5"; EFFORT="$6"; EXTRA="$7"
log() { printf '%s [restart-driver] %s\n' "$(date '+%F %T')" "$*"; }
fg()  { "$TMUX_BIN" display-message -p -t "$PANE" '#{pane_current_command}'; }
mode_fix() {  # vim NORMAL mode → INSERT
  "$TMUX_BIN" capture-pane -p -t "$PANE" | tail -6 | grep -qE -- '-- NORMAL --' \
    && { "$TMUX_BIN" send-keys -t "$PANE" -l 'i'; sleep 0.3; }
}
tui_type() { mode_fix; "$TMUX_BIN" send-keys -t "$PANE" -l -- "$1"; sleep 0.5; "$TMUX_BIN" send-keys -t "$PANE" Enter; }
# At idle the leading "/" opens the command palette, and characters that
# arrive in the same input tick can be swallowed by its initialization
# (observed live: only the trailing "t" of /exit survived and Enter
# submitted it as a user message). Stage the command in two paced sends
# and press Enter only after the input box visibly holds /exit.
type_exit() {
  for attempt in 1 2 3; do
    mode_fix
    "$TMUX_BIN" send-keys -t "$PANE" -l '/'
    sleep 0.6
    "$TMUX_BIN" send-keys -t "$PANE" -l 'exit'
    sleep 0.6
    # capture-pane pads to full pane height with blank lines, so strip them
    # before windowing; the TUI also renders a no-break space (C2 A0) after
    # the ❯ prompt — normalize it to plain spaces before matching
    if "$TMUX_BIN" capture-pane -p -t "$PANE" | sed '/^[[:space:]]*$/d' | tail -10 | tr '\302\240' '  ' | grep -qE '[>❯] */exit'; then
      "$TMUX_BIN" send-keys -t "$PANE" Enter
      return 0
    fi
    log "stage attempt $attempt: /exit not in input box → clear and retry"
    "$TMUX_BIN" send-keys -t "$PANE" Escape
    sleep 0.3
    for _ in $(seq 1 8); do "$TMUX_BIN" send-keys -t "$PANE" BSpace; done
    sleep 0.5
  done
  log "FAIL: could not stage /exit after 3 attempts — aborting, session left intact"
  return 1
}

log "start pane=$PANE sid=$SID"
sleep 15                              # let the session finish its last message
idle=0
for _ in $(seq 1 60); do              # wait for turn streaming to end (max 2 min)
  if "$TMUX_BIN" capture-pane -p -t "$PANE" | grep -q 'to interrupt'; then idle=0; else idle=$((idle+1)); fi
  [ "$idle" -ge 3 ] && break
  sleep 2
done
# preserve session state across the relaunch: pin the model + effort captured
# at arm time (a bare --resume falls back to defaults — effort resets and the
# changed system prompt breaks the warm prompt cache), keep the bypass flag
# only if the footer showed it on, and append caller extras. An extra that
# names --model/--effort itself replaces the pinned one (pin is dropped).
# Every typed value is single-quoted: the command lands in the pane's live
# shell, where an unquoted claude-fable-5[1m] is a zsh glob ("no matches
# found" — the relaunch never runs).
case " $EXTRA" in *" --model"*)  MODEL=""  ;; esac
case " $EXTRA" in *" --effort"*) EFFORT="" ;; esac
FLAGS=""
[ -n "$MODEL" ]  && FLAGS="$FLAGS --model '$MODEL'"
[ -n "$EFFORT" ] && FLAGS="$FLAGS --effort '$EFFORT'"
"$TMUX_BIN" capture-pane -p -t "$PANE" | grep -q 'bypass permissions on' && FLAGS="$FLAGS --dangerously-skip-permissions"
if [ -n "$EXTRA" ]; then
  read -ra EXTRA_WORDS <<< "$EXTRA"
  for w in "${EXTRA_WORDS[@]}"; do FLAGS="$FLAGS '$w'"; done
fi
log "turn idle → sending /exit (resume flags:${FLAGS:- none})"
type_exit || exit 1
# /exit with live background tasks opens a "Background work is running"
# confirm dialog instead of exiting — Enter takes the preselected
# "Exit and stop tasks" (restart kills background work by contract).
for _ in $(seq 1 90); do
  case "$(fg)" in zsh|bash|fish|sh) break ;; esac
  if "$TMUX_BIN" capture-pane -p -t "$PANE" | grep -q 'Background work is running'; then
    log "background-work dialog → confirming (exit and stop tasks)"
    "$TMUX_BIN" send-keys -t "$PANE" Enter
  fi
  sleep 1
done
case "$(fg)" in zsh|bash|fish|sh) ;; *) log "FAIL: claude did not exit (fg=$(fg))"; exit 1 ;; esac
log "claude exited → relaunching (real binary, alias bypassed)"
sleep 1
"$TMUX_BIN" send-keys -t "$PANE" -l -- "$BIN --resume $SID$FLAGS"
sleep 0.5
"$TMUX_BIN" send-keys -t "$PANE" Enter
for _ in $(seq 1 60); do case "$(fg)" in zsh|bash|fish|sh) sleep 1 ;; *) break ;; esac; done
case "$(fg)" in zsh|bash|fish|sh) log "FAIL: claude did not come back"; exit 1 ;; esac
log "claude relaunched → waiting for session load"
sleep 12
tui_type '[cc-self restart driver] Automated restart sequence complete. Verify session continuity and report the result to the user.'
log "wake-up message sent — driver done"
DRV
    chmod +x "$DRIVER"
    tmux run-shell -b "/bin/bash '$DRIVER' '$PANE' '$SID' '$CLAUDE_BIN' '$TMUX_BIN' '$MODEL' '$EFFORT' '$EXTRA' >> '$LOG' 2>&1"
    logit "restart: sid=$SID bin=$CLAUDE_BIN model=${MODEL:-?} effort=${EFFORT:-?}${EXTRA:+ extra=$EXTRA}"
    echo "restart driver armed — after this turn ends: /exit → resume pinning model=${MODEL:-default} effort=${EFFORT:-default}${EXTRA:+ + $EXTRA} (log: $LOG)"
    ;;
  *)
    usage
    ;;
esac
