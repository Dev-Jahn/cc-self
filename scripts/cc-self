#!/bin/bash
# ============================================================================
# cc-self — let a Claude Code session control its own TUI
#
# The session's Bash tool runs inside the same tmux pane as the Claude Code
# TUI, so `tmux send-keys` to that pane ($TMUX_PANE) is literally typing into
# the session's own input box. This unlocks user-side slash commands
# (/reload-plugins, /effort, /model, /plugin ...), dialog navigation, and
# even full self-restart.
#
# usage:
#   cc-self type "/reload-plugins"    type text + Enter (default)
#   cc-self type -w "/reload-plugins" ...then queue a wake-up message after it
#                                     (slash commands alone never re-invoke the
#                                     model — chain -w to continue autonomously)
#   cc-self type -n "text"            type without Enter (stage in input box)
#   cc-self type --paste "text"       deliver via bracketed paste instead of
#                                     keystrokes — REQUIRED for long text and
#                                     slash commands with long arguments
#   cc-self type --from-file <path>   paste a file's contents (implies --paste)
#   cc-self key <name>                send one special key (Escape, C-u, Up...)
#   cc-self clear                     empty the input box (backspace burst)
#   cc-self peek [N]                  show last N lines of the pane (default 20)
#   cc-self pane                      show target pane info
#   cc-self sid                       print current session id
#   cc-self status                    show in-flight drivers + recover state
#   cc-self restart [sid] [-- flags]  restart own session (delegates a driver
#                                     to the tmux server: waits for turn end,
#                                     /exit, claude --resume with the session's
#                                     model/effort pinned, wake-up message).
#                                     flags after -- are appended to the resume
#                                     command verbatim and win over the pinned
#                                     ones (e.g. -- --effort max)
#   cc-self recover --compact-file <f> [--baseline <model>] [--attempt N] [--force]
#   cc-self recover --status          show the recovery state machine
#   cc-self recover --close           close the recovery by operator decision
#                                     (guard stops instructing re-arms)
#                                     deterministic model-fallback recovery:
#                                     wraps the file's instructions into
#                                     /compact "...", pastes + submits it, then
#                                     a detached driver waits out the compaction
#                                     (transcript truth), switches /model back
#                                     to the baseline (confirm dialog approved
#                                     only if one appears — post-compaction
#                                     switches are dialog-free), wakes the
#                                     session, and verifies the live model from
#                                     the session transcript. One driver per
#                                     session: re-arming while one is alive is
#                                     refused (--force supersedes it).
#
# target pane priority: --pane <id> > $CC_SELF_PANE > $TMUX_PANE (self)
# baseline priority: --baseline > $CC_SELF_BASELINE (own session only: our
#   environment says nothing about a --pane target) > settings.json model —
#   nothing declared means nothing to recover to (recover refuses)
# session id priority:  --sid <id> > $CLAUDE_CODE_SESSION_ID/$CLAUDE_SESSION_ID
#                       (self pane only) > newest transcript for the pane's cwd
# every send is logged to $CC_SELF_LOG (default ~/.cc-self.log)
#
# notes:
#  - `type` sends text only. Control keys must go through `key` — prevents
#    accidentally interrupting the session's own turn (Escape) or killing it.
#  - raw keystroke bursts mangle long input: the command palette opened by a
#    leading "/" can swallow same-tick characters, and multibyte (IME) text
#    drops under load — a 3.8KB /compact was observed live mangled into a
#    plain-text message. --paste avoids all of it: the TUI receives a single
#    bracketed-paste event, and the box is verified before Enter.
#  - vim keybindings: when the pane shows `-- NORMAL --`, an `i` is sent
#    first to enter INSERT mode (typing into NORMAL mode gets eaten as vim
#    commands — "cc" is change-line).
#  - slash commands with arguments execute immediately even mid-turn and may
#    open confirmation dialogs: peek first, then `key Enter` deliberately.
#  - detached helpers (drivers, wakers) run under the tmux server via
#    `run-shell -b`. tmux echoes a non-zero exit of such a job as a view-mode
#    overlay on whichever pane currently has FOCUS ("'…' returned 1" floating
#    over an unrelated pane), and it expands #{…}/#(…) formats inside the
#    command string. So: helpers always exit 0 (failures are recorded in the
#    log and the per-session state file), every value on that command line is
#    shell-quoted with '#' doubled, and payload text travels by file.
# ============================================================================
set -u

LOG="${CC_SELF_LOG:-$HOME/.cc-self.log}"
PANE="${CC_SELF_PANE:-${TMUX_PANE:-}}"
SELF_PANE="${TMUX_PANE:-}"
STATE_DIR="$HOME/.cc-self/state"
LIB="$HOME/.cc-self/lib.sh"
SID_OVERRIDE=""

usage() { awk 'NR>=5 && /^# =+$/ {exit} NR>=5' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
logit() { printf '%s pane=%s %s\n' "$(date '+%F %T')" "$PANE" "$*" >> "$LOG"; }

# ---- quoting for detached jobs ---------------------------------------------
# tmux run-shell hands its argument to /bin/sh -c AFTER expanding tmux formats
# (#{…} substitutes, #(…) RUNS a command, ## is a literal #). Every value that
# reaches that string is single-quoted for sh AND has its '#' doubled; payload
# text (wake notes, compact instructions) never rides that command line at
# all — it travels by file.
shq()   { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
tmuxq() { printf '%s' "$1" | sed 's/#/##/g'; }
# detach <sh-command built with shq>: run it detached under the tmux server,
# output to the log, exit status swallowed (a non-zero status would be echoed
# by tmux as a view-mode overlay on the focused pane).
detach() { tmux run-shell -b "$(tmuxq "$1 >> $(shq "$LOG") 2>&1 || true")"; }

# ---- session / transcript resolution ---------------------------------------
is_self()  { [ -n "$SELF_PANE" ] && [ "$PANE" = "$SELF_PANE" ]; }
enc_path() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }   # Claude Code's project-dir encoding
pane_cwd() { tmux display-message -p -t "$PANE" '#{pane_current_path}' 2>/dev/null; }
resolve_sid() {
  if [ -n "$SID_OVERRIDE" ]; then printf '%s' "$SID_OVERRIDE"; return; fi
  if is_self; then   # env names OUR session; for a foreign pane it would be wrong
    local e="${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
    [ -n "$e" ] && { printf '%s' "$e"; return; }
  fi
  local cwd d
  cwd="$(pane_cwd)"; [ -n "$cwd" ] || cwd="$(pwd)"
  d="$HOME/.claude/projects/$(enc_path "$cwd")"
  # shellcheck disable=SC2012  # transcript filenames are UUIDs (no spaces/newlines); ls -t sorts by mtime cleanly
  ls -t "$d"/*.jsonl 2>/dev/null | head -1 | sed -E 's|.*/||; s|\.jsonl$||'
}
find_transcript() {  # find_transcript <sid> — the pane's cwd project first, then anywhere
  local cwd p
  cwd="$(pane_cwd)"; [ -n "$cwd" ] || cwd="$(pwd)"
  p="$HOME/.claude/projects/$(enc_path "$cwd")/$1.jsonl"
  [ -f "$p" ] && { printf '%s' "$p"; return; }
  # shellcheck disable=SC2012  # sid is a UUID; glob yields at most one clean path
  ls "$HOME"/.claude/projects/*/"$1".jsonl 2>/dev/null | head -1
}

# ---- state files -----------------------------------------------------------
# Strictly per-session, keyed by sid: recover-<sid>.json / restart-<sid>.json
# (single-line JSON written by us; read back with greps, no parser needed).
jstr() { grep -o "\"$2\":\"[^\"]*\"" "$1" 2>/dev/null | head -1 | cut -d'"' -f4; }
jnum() { grep -o "\"$2\":[0-9]*" "$1" 2>/dev/null | head -1 | cut -d: -f2; }
job_alive() { case "${1:-}" in ''|0) return 1 ;; esac; kill -0 "$1" 2>/dev/null; }
# inflight_driver <sid> → prints "<kind> <phase> <pid>" and returns 0 if a live
# driver owns this session (recover or restart). A driver records its pid on
# its first state write; a pid-less ARMED state is trusted for one minute
# (the window between arming and the driver's start).
inflight_driver() {
  local f kind phase pid
  for kind in recover restart; do
    f="$STATE_DIR/$kind-$1.json"; [ -f "$f" ] || continue
    phase="$(jstr "$f" phase)"; pid="$(jnum "$f" pid)"
    case "$phase" in ''|DONE|CLOSED|FAILED-*) continue ;; esac
    if job_alive "$pid"; then printf '%s %s %s\n' "$kind" "$phase" "$pid"; return 0; fi
    if [ -z "$pid" ] && [ -n "$(find "$f" -mmin -1 2>/dev/null)" ]; then printf '%s %s -\n' "$kind" "$phase"; return 0; fi
  done
  return 1
}
gc_state() {  # age-based GC: states of long-gone sessions, stale yield flags
  mkdir -p "$STATE_DIR"
  find "$STATE_DIR" -name 'recover-*.json' -mtime +7 -delete 2>/dev/null
  find "$STATE_DIR" -name 'restart-*.json' -mtime +7 -delete 2>/dev/null
  find "$STATE_DIR" -name 'recover-*-screen.txt' -mtime +7 -delete 2>/dev/null
  find "$STATE_DIR" -name 'yield-*' -mtime +1 -delete 2>/dev/null
  find "$STATE_DIR" -name 'model-sends-*' -mtime +7 -delete 2>/dev/null
}
# note_model_send <sid> <text>: a /model that cc-self types is a real switch
# but never a declaration of the session's baseline — the guard hook reads
# this file to tell it from a /model the user typed (same transcript record).
note_model_send() {
  case "$2" in "/model"|"/model "*) printf '%s %s\n' "$(date +%s)" "$2" >> "$STATE_DIR/model-sends-$1" ;; esac
}

settings_model() {  # machine-wide declared model, e.g. claude-fable-5[1m]
  grep -o '"model"[[:space:]]*:[[:space:]]*"[^"]*"' "$HOME/.claude/settings.json" 2>/dev/null | head -1 | cut -d'"' -f4
}
baseline_model() {  # the declared baseline: per-session env beats settings.json (same rule as hooks/model-guard.py)
  local e; e="$(printf '%s' "${CC_SELF_BASELINE:-}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  if [ -n "$e" ]; then printf '%s\n' "$e"; else settings_model; fi
}

model_label() {
  # model id/arg → statusline label, by normalization (not a fixed table).
  # Rules — keep in lockstep with model_label() in hooks/model-guard.py:
  # strip [..] context suffix → strip claude- prefix → drop -YYYYMMDD date
  # suffix → digit-digit hyphens become dots → hyphens become spaces →
  # capitalize each word. claude-fable-5[1m]→"Fable 5",
  # claude-opus-4-8→"Opus 4.8", claude-haiku-4-5-20251001→"Haiku 4.5".
  local m="${1%%\[*}"
  case "$m" in
    # exceptions normalization cannot produce go here (none known today)
    *) ;;
  esac
  m="${m#claude-}"
  m="$(printf '%s' "$m" | sed -E -e 's/-[0-9]{8}$//' -e ':a' -e 's/([0-9])-([0-9])/\1.\2/' -e 'ta' | tr '-' ' ')"
  printf '%s\n' "$m" | awk '{for(i=1;i<=NF;i++){$i=toupper(substr($i,1,1)) substr($i,2)}}1'
}

# ---- shared TUI library ----------------------------------------------------
# One implementation of screen reading, paste-staging, idle detection and
# transcript reading, used by this CLI AND by every detached helper (which
# source it). Rewritten on every run so helpers always get the current copy.
write_lib() {
  mkdir -p "$(dirname "$LIB")"
  cat > "$LIB.tmp" <<'LIB'
#!/bin/bash
# cc-self shared library — generated by scripts/cc-self, do not edit.
# Requires PANE and TMUX_BIN in the environment of the sourcing script. An
# EMPTY tmux target (-t '') silently means the CURRENT pane, so an unset PANE
# must never reach a send: refuse to load instead.
[ -n "${PANE:-}" ] && [ -n "${TMUX_BIN:-}" ] || { echo "cc-self lib: PANE/TMUX_BIN unset — refusing to load" >&2; return 1; }
log()  { printf '%s [%s] %s\n' "$(date '+%F %T')" "${LOGTAG:-cc-self}" "$*"; }
# the TUI pads a no-break space (C2 A0) after the ❯ prompt — normalize it.
# sed, not tr: GNU tr (and BSD tr in the C locale a tmux server usually
# runs in) is byte-wise and would also mangle every other C2/A0 byte ("·",
# "©", some Korean syllables). Fails only when the pane cannot be captured.
NBSP="$(printf '\302\240')"
same_model() {
  # declared baseline vs live transcript id — either side may be a bare id
  # (claude-sonnet-5), a dated snapshot (claude-haiku-4-5-20251001), a
  # suffixed form (claude-fable-5[1m]) or an alias (sonnet, opus, haiku,
  # fable, opusplan). Keep in lockstep with same_model() in hooks/model-guard.py.
  local a b x
  a="$(printf '%s' "${1%%\[*}" | sed -E 's/-[0-9]{8}$//')"; b="$(printf '%s' "${2%%\[*}" | sed -E 's/-[0-9]{8}$//')"
  [ -n "$a" ] && [ -n "$b" ] || return 1
  [ "$a" = "$b" ] && return 0
  for x in "$a:$b" "$b:$a"; do
    case "${x%%:*}" in
      *-*) ;;
      opusplan) case "${x#*:}" in claude-opus|claude-opus-*|claude-sonnet|claude-sonnet-*) return 0 ;; esac ;;
      *) case "${x#*:}" in "claude-${x%%:*}"|"claude-${x%%:*}-"*) return 0 ;; esac ;;
    esac
  done
  return 1
}
norm() { local out; out="$("$TMUX_BIN" capture-pane -p -t "$PANE" 2>/dev/null)" || return 1; printf '%s\n' "$out" | sed "s/$NBSP/ /g"; }
fg()   { "$TMUX_BIN" display-message -p -t "$PANE" '#{pane_current_command}' 2>/dev/null; }
pane_pid() { "$TMUX_BIN" display-message -p -t "$PANE" '#{pane_pid}' 2>/dev/null; }
# Is a Claude Code process running in the pane's process tree? pane_current_
# command is NOT a reliable signal: a non-interactive wrapper shell (bash -c
# "claude; …", broker scripts) keeps the tty's process group, so tmux reports
# "bash" while the TUI is alive. Walk the tree from pane_pid instead and look
# for an executable named claude (symlink, versioned binary, or node cli).
tui_alive() {
  local root; root="$(pane_pid)"; [ -n "$root" ] || return 1
  ps -A -o pid=,ppid=,args= 2>/dev/null | awk -v root="$root" '
    { n=split($0, a, " "); par[a[1]]=a[2]; exe[a[1]]=(n>=3?a[3]:""); arg[a[1]]=(n>=4?a[4]:"") }
    END {
      proc = (system("test -r /proc/self/exe") == 0)
      q[0]=root; seen[root]=1; head=0; tail=1; found=0
      while (head<tail) {
        p=q[head++]; x=exe[p]; ar=arg[p]
        # Identity = the executable, resolved by the kernel where the OS gives
        # it away for free (/proc/PID/exe on Linux; argv[0] can be anything —
        # exec -a), else the executable as invoked (argv[0]). Never a substring
        # of the whole command line, and only inside this pane tree: a process
        # that merely mentions claude in an argument (cat ~/.claude/x) is not
        # the TUI. On macOS the native binary is really ~/.claude/versions/N.N.N
        # (kernel basename = the version), hence the versions-path rule.
        if (proc) { cmd="readlink /proc/" p "/exe 2>/dev/null"; r=""; if ((cmd | getline r) > 0 && r != "") { sub(/ \(deleted\)$/, "", r); x=r }; close(cmd) }
        e=x; sub(/.*\//, "", e)
        if (e == "claude" || x ~ /\/claude\/versions\// ||
            ((e ~ /^(node|bun)/) && (ar ~ /(^|\/)claude$|claude-code|\/cli\.js$/))) found=1
        for (c in par) if (par[c]==p && !seen[c]) { seen[c]=1; q[tail++]=c }
      }
      exit found ? 0 : 1 }'
}
# The input box is the ❯ line framed by horizontal rules (a bare ❯ line
# elsewhere is an ECHOED user message or queued command in the conversation
# area, e.g. "❯ /compact …"). box_line prints the framed line (first visual
# line only when the text wraps); on an unframed TUI it falls back to the
# last ❯ line.
box_line() {
  norm | awk 'prev ~ /^─/ && $0 ~ /^❯/ {b=$0; f=1} $0 ~ /^❯/ {l=$0} {prev=$0} END{print (f ? b : l)}'
}
box()     { box_line | sed 's/^❯ *//; s/ *$//'; }
has_box() { [ -n "$(box_line)" ]; }
# an INDENTED highlighted option (" ❯ 1. Yes, switch to …", " ❯ No, exit") =
# some dialog/menu is up (confirm dialogs, permission prompts, pickers); the
# input box and echoed messages sit at column 0. Dialogs REPLACE the framed
# input box, so an indented ❯ while the box is on screen is just a tool
# result echoing one (a `cc-self peek` output). Never type into a dialog.
dialog_open() { ! has_box && norm | tail -30 | grep -qE '^ +❯ '; }
# vim keybindings: NORMAL mode eats input as commands ("cc" is change-line,
# a leading "Reply wi…" was observed swallowed live) — enter INSERT first.
# The TUI shows "-- INSERT --" / "-- VISUAL --" but NOTHING for NORMAL, so
# with vim mode on, "no indicator" means NORMAL — unless the user hid the
# indicator, in which case the mode is unknowable and callers rely on the
# staged-text verification (stage_exact clears and retries a mismatch).
vim_on() {
  [ -n "${VIM_ON:-}" ] || {
    VIM_ON=0
    grep -qE '"editorMode"[[:space:]]*:[[:space:]]*"vim"' "$HOME/.claude/settings.json" 2>/dev/null && VIM_ON=1
    grep -qE '"hideVimModeIndicator"[[:space:]]*:[[:space:]]*true' "$HOME/.claude/settings.json" 2>/dev/null && VIM_ON=2
  }
  [ "$VIM_ON" -eq 1 ]
}
mode_fix() {
  local t; t="$(norm | tail -6)"
  case "$t" in *'-- NORMAL --'*) "$TMUX_BIN" send-keys -t "$PANE" -l 'i'; sleep 0.3; return ;; esac
  vim_on || return 0
  case "$t" in *'-- INSERT --'*|*'-- VISUAL --'*) return 0 ;; esac
  "$TMUX_BIN" send-keys -t "$PANE" -l 'i'; sleep 0.3
}
clear_box() { mode_fix; "$TMUX_BIN" send-keys -N 120 -t "$PANE" BSpace; sleep 0.5; }
# Busy detection. Known busy wordings (TUI versions vary — 2.1.258's spinner
# carries no "esc to interrupt" hint at all) are backed by a wording-free
# signal: a running turn animates its spinner glyph and elapsed counter every
# second, so the conversation area (everything above the input box) changes
# between polls. The bottom window is tail -15 on purpose: conversation text
# higher up may legitimately contain these words.
busy_text() {  # only the last lines of the conversation area: the spinner/status line lives there, tool results echoing these words sit higher
  convo | sed '/^[[:space:]]*$/d' | tail -4 | grep -qE 'to interrupt|Compacting|Running (PreCompact|PostCompact|SessionStart) hooks|… \([0-9]+(m [0-9]+)?s ·'
}
convo() {  # everything above the input box (the whole screen when no box is framed)
  norm | awk '{l[NR]=$0; if (prev ~ /^─/ && $0 ~ /^❯/) top=NR-1; prev=$0} END{n=(top?top:NR); for(i=1;i<=n;i++) print l[i]}'
}
# wait_idle <max-seconds> → 0 idle, 1 timeout, 2 pane/TUI gone.
# idle = input box on screen, no dialog up, no busy text, and the
# conversation area unchanged across 3 polls two seconds apart.
wait_idle() {
  local deadline=$(( $(date +%s) + $1 )) prev="" cur stable=0
  while [ "$(date +%s)" -lt "$deadline" ]; do
    norm >/dev/null || return 2
    tui_alive || return 2
    cur="$(convo)"
    if busy_text || dialog_open || ! has_box || [ "$cur" != "$prev" ]; then stable=0; else stable=$((stable+1)); fi
    prev="$cur"
    [ "$stable" -ge 3 ] && return 0
    sleep 2
  done
  return 1
}
# paste_stage <file>: bracketed-paste a file's contents into the input box and
# verify the box verifiably holds literal text. Does NOT press Enter — the
# caller decides. Sets PASTE_BYTES / PASTE_BOX. Returns 1 without submitting
# anything on failure (never Escape: on self-use the session's own turn may
# be running and Escape would interrupt it).
paste_stage() {
  local src="$1" ok=0
  # shellcheck disable=SC2034  # read by callers after sourcing
  PASTE_BYTES="$(wc -c < "$src" | tr -d ' ')"
  PASTE_BOX=""
  mode_fix
  "$TMUX_BIN" load-buffer -b cc-self-paste "$src"
  for _ in 1 2 3 4; do
    "$TMUX_BIN" paste-buffer -p -b cc-self-paste -t "$PANE"
    # a multi-KB paste can take the TUI a moment to render: look for up to
    # 4 s before concluding nothing arrived (a blind re-paste would submit
    # the text twice in one message)
    PASTE_BOX=""
    for _ in 1 2 3 4 5 6 7 8; do sleep 0.5; PASTE_BOX="$(box)"; [ -n "$PASTE_BOX" ] && break; done
    [ -z "$PASTE_BOX" ] && continue      # nothing arrived → paste again
    # a large paste collapses to "[Pasted text #N]"; submitting that sends
    # plain text, not a slash command — pasting the same buffer again
    # expands it to literal text (the TUI's "paste again to expand")
    case "$PASTE_BOX" in '[Pasted text #'*) continue ;; esac
    ok=1; break
  done
  "$TMUX_BIN" delete-buffer -b cc-self-paste 2>/dev/null
  [ "$ok" -eq 1 ]
}
# stage_exact <text>: paste + verify the box holds exactly this text (its
# first visual line when it wraps). IDLE ONLY — clears the box between tries.
stage_exact() {
  local want="$1" f i
  for i in 1 2 3; do
    f="$(mktemp "${TMPDIR:-/tmp}/cc-self-stage.XXXXXX")"
    printf '%s' "$want" > "$f"
    paste_stage "$f"; rm -f "$f"
    if [ -n "$PASTE_BOX" ]; then case "$want" in "$PASTE_BOX"*) return 0 ;; esac; fi
    log "stage try $i: box holds '${PASTE_BOX:-}' — clearing and retrying"
    clear_box
  done
  return 1
}
# submit <staged-text>: Enter, then confirm the staged text LEFT the box (an
# Enter can be swallowed by an autocomplete popup — retry once, never more).
# "Left the box" rather than "box empty": mid-turn the TUI queues the message
# and shows a placeholder hint ("Press up to edit queued messages"), and at
# idle it may show a dim suggestion — neither is typed text.
box_holds() { local b; b="$(box)"; [ -n "$b" ] && case "$1" in "$b"*) return 0 ;; esac; return 1; }
submit() {
  local want="$1" i
  for i in 1 2; do
    "$TMUX_BIN" send-keys -t "$PANE" Enter
    sleep 1.5
    box_holds "$want" || return 0
    log "Enter did not submit (box still holds '$(box)') — retry $i"
  done
  ! box_holds "$want"
}
# tx_after <transcript> <byte-offset> <model|compact>: transcript truth.
#   model   → newest main-chain assistant model recorded after the offset
#   compact → "1" once a compact_boundary record (or the compact summary)
#             appears after the offset
tx_after() {
  [ -n "${PY_BIN:-}" ] || PY_BIN="$(command -v python3 2>/dev/null)"
  [ -n "$PY_BIN" ] || return 0
  "$PY_BIN" - "$1" "$2" "$3" <<'PY' 2>/dev/null
import json, sys
path, off, mode = sys.argv[1], int(sys.argv[2]), sys.argv[3]
try:
    f = open(path, 'rb'); f.seek(off); data = f.read().decode('utf-8', 'ignore')
except Exception:
    sys.exit(0)
out = ""
for line in data.splitlines():
    try:
        d = json.loads(line)
    except Exception:
        continue
    if mode == "compact":
        if (d.get("type") == "system" and d.get("subtype") == "compact_boundary") or d.get("isCompactSummary"):
            out = "1"
        continue
    if d.get("isSidechain"):
        continue
    m = d.get("message", {})
    if isinstance(m, dict) and m.get("role") == "assistant":
        mod = m.get("model")
        if mod and mod != "<synthetic>":
            out = mod
print(out)
PY
}
LIB
  mv "$LIB.tmp" "$LIB"
}

# parse global options anywhere in the arg list
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --pane) [ -n "${2:-}" ] || { echo "cc-self: --pane needs a pane id"; exit 1; }; PANE="$2"; shift 2 ;;
    --sid)  [ -n "${2:-}" ] || { echo "cc-self: --sid needs a session id"; exit 1; }; SID_OVERRIDE="$2"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

[ $# -ge 1 ] || usage
CMD="$1"; shift

case "$CMD" in sid) resolve_sid; echo; exit 0 ;; esac

[ -n "$PANE" ] || { echo "cc-self: cannot determine target pane (not inside tmux?)"; exit 1; }
tmux has-session 2>/dev/null || { echo "cc-self: no tmux server"; exit 1; }
TMUX_BIN="$(command -v tmux)"
PY_BIN="$(command -v python3 2>/dev/null || true)"
write_lib
# shellcheck disable=SC1090  # generated above
. "$LIB"
gc_state

warn_inflight() {  # manual TUI input can race a running driver — say so, don't block
  local sid d
  sid="$(resolve_sid)"; [ -n "$sid" ] || return 0
  d="$(inflight_driver "$sid")" || return 0
  echo "cc-self: warning — a ${d%% *} driver is in flight for this session (${d#* }); manual TUI input may race it" >&2
}

case "$CMD" in
  pane)
    tmux display-message -p -t "$PANE" \
      '#{pane_id} #{session_name}:#{window_index}.#{pane_index} cmd=#{pane_current_command} title=#{pane_title} path=#{pane_current_path}'
    ;;
  peek)
    N="${1:-20}"
    tmux capture-pane -p -t "$PANE" | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' | tail -n "$N"
    ;;
  status)
    SID="$(resolve_sid)"
    echo "pane=$PANE sid=${SID:-?} self=$(is_self && echo yes || echo no)"
    if d="$(inflight_driver "${SID:-none}")"; then echo "in flight: $d"; else echo "in flight: none"; fi
    for k in recover restart; do
      f="$STATE_DIR/$k-${SID:-none}.json"; [ -f "$f" ] && { printf '%s: ' "$k"; cat "$f"; }
    done
    exit 0
    ;;
  type)
    NO_ENTER=0; WAKE=0; PASTE=0; FROM=""
    while :; do
      case "${1:-}" in
        -n) NO_ENTER=1; shift ;;
        -w|--wake) WAKE=1; shift ;;
        --paste) PASTE=1; shift ;;
        --from-file)
          [ -n "${2:-}" ] || { echo "cc-self type: --from-file needs a path"; exit 1; }
          FROM="$2"; PASTE=1; shift 2 ;;
        *) break ;;
      esac
    done
    TEXT=""
    if [ -n "$FROM" ]; then
      [ -f "$FROM" ] || { echo "cc-self type: no such file: $FROM"; exit 1; }
    else
      [ $# -ge 1 ] || { echo "cc-self type: nothing to send"; exit 1; }
      TEXT="$*"
    fi
    warn_inflight
    case "${TEXT:-$(head -c 7 "$FROM" 2>/dev/null)}" in "/model"|"/model "*)
      SID="$(resolve_sid)"; [ -n "$SID" ] && note_model_send "$SID" "${TEXT:-$(head -1 "$FROM")}" ;;
    esac
    if [ "$PASTE" -eq 1 ]; then
      # Bracketed paste: the TUI receives the text as one paste event, so
      # nothing is interpreted per-keystroke — no command-palette race on a
      # leading "/", no multibyte drops in long bursts.
      SRC="$FROM"; TMP=""
      if [ -z "$SRC" ]; then
        TMP="$(mktemp "${TMPDIR:-/tmp}/cc-self-paste.XXXXXX")"
        printf '%s' "$TEXT" > "$TMP"
        SRC="$TMP"
      fi
      OK=0; paste_stage "$SRC" && OK=1
      BYTES="$PASTE_BYTES"
      [ -n "$TMP" ] && rm -f "$TMP"
      if [ "$OK" -ne 1 ]; then
        # abort without Enter and without clearing: on self-use the session's
        # own turn is running, and Escape would interrupt it — peek, then
        # recover deliberately (a collapsed placeholder deletes with BSpace)
        logit "type (paste) FAIL: box did not reach literal state (box: ${PASTE_BOX:-empty})"
        echo "cc-self type: paste did not verify (box: ${PASTE_BOX:-empty}) — nothing submitted; peek and recover" >&2
        exit 1
      fi
      DESC="paste ${BYTES}B${FROM:+ from $FROM}"
    else
      mode_fix
      tmux send-keys -t "$PANE" -l -- "$TEXT"
      sleep 0.3   # let the TUI process input (autocomplete popup etc.)
      DESC="$TEXT"
    fi
    [ "$NO_ENTER" -eq 0 ] && tmux send-keys -t "$PANE" Enter
    if [ "$WAKE" -eq 1 ]; then
      # Slash commands execute locally and never start a model turn. A plain
      # message CANNOT simply be queued behind them: mid-turn, the TUI injects
      # queued plain text into the RUNNING turn while slash commands stay
      # queued — the wake would be consumed before the command runs. So the
      # wake is typed by a detached waker (tmux server process) that waits for
      # the turn to end and queued commands to drain first. The note travels
      # by file: it is user text and must never ride a shell command line.
      WAKER="$HOME/.cc-self-waker.sh"
      cat > "$WAKER.tmp" <<'WKR'
#!/bin/bash
# cc-self waker — runs detached under the tmux server. Always exits 0.
PANE="$1"; NOTE_FILE="$2"; TMUX_BIN="$3"; LIB="$4"
[ -n "$PANE" ] && [ -n "$TMUX_BIN" ] && [ -f "$LIB" ] || { echo "cc-self waker: missing PANE/TMUX_BIN/LIB — refusing to run" >&2; exit 0; }
export PANE TMUX_BIN LOGTAG=waker
# shellcheck disable=SC1090  # generated by scripts/cc-self
. "$LIB" || exit 0
NOTE="$(head -c 300 "$NOTE_FILE" 2>/dev/null | tr '\n' ' ')"; rm -f "$NOTE_FILE"
log "armed pane=$PANE"
sleep 5
# wait for the running turn to end and queued commands (possibly a whole
# compaction) to drain — up to 30 min, as long as the TUI is alive
wait_idle 1800; rc=$?
case "$rc" in
  1) log "turn still busy after 30 min — wake not sent"; exit 0 ;;
  2) log "pane/TUI gone — wake not sent"; exit 0 ;;
esac
sleep 2
WAKE="[cc-self wake] continue after: $NOTE"
if stage_exact "$WAKE" && submit "$WAKE"; then
  log "wake sent"
else
  log "wake could not be staged/submitted (box: '$(box)')"
fi
exit 0
WKR
      chmod +x "$WAKER.tmp" && mv "$WAKER.tmp" "$WAKER"   # never rewrite a helper in place
      NOTE="$TEXT"
      [ "$PASTE" -eq 1 ] && NOTE="pasted input (${BYTES} bytes)"
      NOTE_FILE="$(mktemp "${TMPDIR:-/tmp}/cc-self-note.XXXXXX")"
      printf '%s' "$NOTE" > "$NOTE_FILE"
      detach "/bin/bash $(shq "$WAKER") $(shq "$PANE") $(shq "$NOTE_FILE") $(shq "$TMUX_BIN") $(shq "$LIB")"
    fi
    logit "type$([ $NO_ENTER -eq 1 ] && echo ' (no-enter)')$([ $WAKE -eq 1 ] && echo ' (+wake)'): $DESC"
    echo "sent to $PANE: $DESC$([ $NO_ENTER -eq 1 ] && echo ' (no Enter)')$([ $WAKE -eq 1 ] && echo ' (+wake queued)')"
    ;;
  key)
    [ $# -ge 1 ] || { echo "cc-self key: key name required (e.g. Escape, C-u, Up)"; exit 1; }
    tmux send-keys -t "$PANE" "$1"
    logit "key: $1"
    echo "sent key to $PANE: $1"
    ;;
  clear)
    clear_box
    logit "clear"
    echo "cleared input of $PANE"
    ;;
  recover)
    # Deterministic model-fallback recovery (compact-first: a bare /model
    # switch does not hold while the trigger content is still in context).
    # The model's ONLY job is writing the compact instruction file; everything
    # else — submitting /compact, waiting out the compaction, switching /model
    # back, approving a dialog if (and only if) one appears, waking the
    # session, and verifying the live model from the transcript — is done
    # mechanically by a detached driver. See skills/model-recovery/SKILL.md.
    COMPACT_FILE=""; BASELINE=""; ATTEMPT=1; CLOSE=0; STATUS=0; FORCE=0
    while :; do
      case "${1:-}" in
        --compact-file) [ -n "${2:-}" ] || { echo "cc-self recover: --compact-file needs a path"; exit 1; }
                        COMPACT_FILE="$2"; shift 2 ;;
        --baseline)     [ -n "${2:-}" ] || { echo "cc-self recover: --baseline needs a model"; exit 1; }
                        BASELINE="$2"; shift 2 ;;
        --attempt)      [ -n "${2:-}" ] || { echo "cc-self recover: --attempt needs a number"; exit 1; }
                        ATTEMPT="$2"; shift 2 ;;
        --close)        CLOSE=1; shift ;;
        --status)       STATUS=1; shift ;;
        --force)        FORCE=1; shift ;;
        *) break ;;
      esac
    done
    SID="$(resolve_sid)"
    [ -n "$SID" ] || { echo "cc-self recover: cannot resolve session id (pass --sid)"; exit 1; }
    STATE="$STATE_DIR/recover-$SID.json"
    if [ "$STATUS" -eq 1 ]; then
      if [ -f "$STATE" ]; then cat "$STATE"; else echo "no recover state for sid=$SID"; fi
      if d="$(inflight_driver "$SID")"; then echo "driver: in flight ($d)"; else echo "driver: none alive"; fi
      exit 0
    fi
    [ "$CLOSE" -eq 1 ] || [ -n "$COMPACT_FILE" ] || { echo "cc-self recover: --compact-file <path> is required (instructions only — no /compact prefix)"; exit 1; }
    [ "$CLOSE" -eq 1 ] || [ -f "$COMPACT_FILE" ] || { echo "cc-self recover: no such file: $COMPACT_FILE"; exit 1; }
    case "$ATTEMPT" in ''|*[!0-9]*) echo "cc-self recover: --attempt must be a number"; exit 1 ;; esac
    if [ -z "$BASELINE" ]; then
      if is_self; then BASELINE="$(baseline_model)"; else BASELINE="$(settings_model)"; fi
    fi
    [ -n "$BASELINE" ] || { echo "cc-self recover: no declared baseline (no --baseline, CC_SELF_BASELINE unset, no model in ~/.claude/settings.json) — nothing to recover to; declare one first"; exit 1; }
    LABEL="$(model_label "$BASELINE")"
    # Truth source for compaction + post-switch verification: the session
    # transcript (compact_boundary records; message.model on every assistant
    # message — the same source the guard hook reads). Statuslines are
    # user-configurable and cannot be relied on.
    TRANSCRIPT="$(find_transcript "$SID")"
    rc_state() {  # rc_state <phase> [note] — note may quote screen content; keep the JSON valid
      local n; n="$(printf '%s' "${2:-}" | tr '\042\134\n' '\047  ')"
      printf '{"sid":"%s","pane":"%s","baseline":"%s","label":"%s","attempt":%s,"phase":"%s","note":"%s","pid":0,"ts":"%s"}\n' \
        "$SID" "$PANE" "$BASELINE" "$LABEL" "$ATTEMPT" "$1" "$n" "$(date '+%FT%T%z')" > "$STATE.$$.tmp" && mv "$STATE.$$.tmp" "$STATE"
    }
    if [ "$CLOSE" -eq 1 ]; then
      # Terminal state by OPERATOR decision — the guard stops instructing
      # re-arms for this session and a live driver stops at its next step.
      # The never-settle directive means this is the user's call, not the
      # model's: only run --close on explicit user instruction.
      OLD_ATTEMPT="$(jnum "$STATE" attempt)"
      ATTEMPT="${OLD_ATTEMPT:-0}"
      rc_state CLOSED "closed by operator decision"
      rm -f "$STATE_DIR/yield-$SID"
      logit "recover: CLOSED by operator (sid=$SID attempt=$ATTEMPT)"
      echo "recover closed (sid=$SID): guard will state the fallback but stop instructing re-arms"
      exit 0
    fi
    [ -n "$TRANSCRIPT" ] && [ -f "$TRANSCRIPT" ] || { echo "cc-self recover: no transcript found for sid=$SID (wrong session? pass --sid)"; exit 1; }
    [ -n "$PY_BIN" ] || echo "cc-self recover: warning — python3 not found; compaction/verification fall back to screen signals only" >&2
    # One driver per session. Re-arming on top of a live driver makes two
    # processes race on the same input box; refuse unless told to supersede.
    if d="$(inflight_driver "$SID")"; then
      if [ "$FORCE" -eq 1 ]; then
        pid="${d##* }"
        job_alive "$pid" && kill "$pid" 2>/dev/null
        logit "recover: superseding in-flight driver ($d) by --force"
      else
        echo "cc-self recover: a ${d%% *} driver is already in flight for sid=$SID (${d#* }) — not re-arming. End the turn and let it finish; --force supersedes it." >&2
        exit 2
      fi
    fi
    OFF_ARM="$(wc -c < "$TRANSCRIPT" 2>/dev/null | tr -d ' ')"; [ -n "$OFF_ARM" ] || OFF_ARM=0
    rc_state ARMED
    # Wrap the instructions into /compact "...". Double quotes inside the
    # instructions would fight the wrapping quotes — normalize to single.
    TMPC="$(mktemp "${TMPDIR:-/tmp}/cc-self-recover.XXXXXX")"
    INSTR="$(sed "s/\"/'/g" "$COMPACT_FILE")"
    printf '/compact "%s"' "$INSTR" > "$TMPC"
    if ! paste_stage "$TMPC"; then
      rm -f "$TMPC"
      rc_state FAILED-COMPACT_STAGE "paste did not verify (box: ${PASTE_BOX:-empty})"
      logit "recover FAIL: compact paste did not verify (box: ${PASTE_BOX:-empty})"
      echo "cc-self recover: compact paste did not verify — nothing submitted; peek and recover" >&2
      exit 1
    fi
    rm -f "$TMPC"
    # mid-turn: /compact queues and drains at idle; at idle it runs at once.
    # Either way the staged text leaves the box on a registered Enter. The
    # "compaction failed" baseline is counted BEFORE the Enter: at idle the
    # failure line ("Not enough messages to compact.") is synchronous and
    # would already be on screen by the time the driver starts.
    COMPACT_FAIL_RE='Compaction failed|Error compacting|Not enough messages to compact|No messages to compact|Compaction canceled'
    FAILS0="$(norm | tail -40 | grep -cE "$COMPACT_FAIL_RE")"
    if ! submit "$PASTE_BOX"; then
      rc_state FAILED-COMPACT_SUBMIT "Enter did not submit; /compact text left staged in the box"
      logit "recover FAIL: /compact Enter did not submit (box: $(box))"
      echo "cc-self recover: Enter did not submit the staged /compact — peek; the text is still in the box" >&2
      exit 1
    fi
    sleep 1
    if [ "$(norm | tail -40 | grep -cE "$COMPACT_FAIL_RE")" -gt "$FAILS0" ]; then
      why="$(norm | tail -40 | grep -E "$COMPACT_FAIL_RE" | tail -1 | sed 's/^[[:space:]⎿]*//')"
      rc_state FAILED-COMPACT_DONE "compaction did not happen: $why"
      logit "recover FAIL: $why"
      echo "cc-self recover: the TUI refused the compaction ($why) — nothing armed; the guard will instruct the next step" >&2
      exit 1
    fi
    rc_state COMPACT_SUBMITTED
    RDRIVER="$HOME/.cc-self-recover-driver.sh"
    cat > "$RDRIVER.tmp" <<'RCV'
#!/bin/bash
# cc-self recover driver — runs detached under the tmux server.
# Phases: ARMED → COMPACT_SUBMITTED → COMPACT_DONE → SWITCH_SUBMITTED → SWITCHED
#         → VERIFY_WAKE → DONE, or FAILED-<phase>. No blind keypress, ever, and
#         the process ALWAYS exits 0 (a non-zero exit of a tmux run-shell -b
#         job is echoed by tmux as a view-mode overlay on the FOCUSED pane).
# Truth sources: the session transcript (compact_boundary → compaction done;
# message.model → live model). Screen text is used to drive the TUI and as a
# fallback signal; statusline/toast checks are advisory only.
PANE="$1"; SID="$2"; BASELINE="$3"; LABEL="$4"; ATTEMPT="$5"; TMUX_BIN="$6"; STATE="$7"; TRANSCRIPT="$8"; OFF_ARM="$9"; PY_BIN="${10:-}"; LIB="${11}"; FAILS0="${12:-0}"
[ -n "$PANE" ] && [ -n "$TMUX_BIN" ] && [ -f "$LIB" ] && [ -n "$STATE" ] || { echo "cc-self recover driver: missing PANE/TMUX_BIN/LIB/STATE — refusing to run" >&2; exit 0; }
export PANE TMUX_BIN PY_BIN LOGTAG=recover-driver
# shellcheck disable=SC1090  # generated by scripts/cc-self
. "$LIB" || exit 0
STATE_DIR="$(dirname "$STATE")"; YIELD="$STATE_DIR/yield-$SID"; SCREEN="$STATE_DIR/recover-$SID-screen.txt"
set_state() {  # set_state <phase> [note] — note may quote screen content; keep the JSON valid
  if grep -q '"phase":"CLOSED"' "$STATE" 2>/dev/null; then log "closed by operator — stopping"; rm -f "$YIELD"; exit 0; fi
  local n; n="$(printf '%s' "${2:-}" | tr '\042\134\n' '\047  ')"
  printf '{"sid":"%s","pane":"%s","baseline":"%s","label":"%s","attempt":%s,"phase":"%s","note":"%s","pid":%s,"ts":"%s"}\n' \
    "$SID" "$PANE" "$BASELINE" "$LABEL" "$ATTEMPT" "$1" "$n" "$$" "$(date '+%FT%T%z')" > "$STATE.$$.tmp" && mv "$STATE.$$.tmp" "$STATE"
}
finish() { rm -f "$YIELD"; exit 0; }
fail() {  # fail <phase> [why] — record, dump the screen for diagnosis, exit 0
  norm | tail -40 > "$SCREEN" 2>/dev/null
  log "FAIL $1${2:+: $2} (screen: $SCREEN)"
  set_state "FAILED-$1" "${2:-}; screen dump: $SCREEN"
  finish
}
alive() {  # pane must exist and still run the TUI (no claude process in its tree = session gone)
  norm >/dev/null || fail "$1" "pane gone (capture failed)"
  tui_alive || fail "$1" "no Claude Code process in pane $PANE (fg=$(fg))"
}
screen_has() { norm | tail -"${2:-20}" | grep -qE "$1"; }
# text that may already be on screen from an EARLIER event (a previous
# "Not enough messages to compact.", an older "Set model to") must not be
# mistaken for a new one: count matches before, react only to an increase
screen_count() { norm | tail -"${2:-25}" | grep -cE "$1"; }
COMPACT_FAIL_RE='Compaction failed|Error compacting|Not enough messages to compact|No messages to compact|Compaction canceled'
SWITCH_OK_RE='Set model to|Kept model as'
SWITCH_ERR_RE='Model switch failed|Unknown model|Invalid model|not a valid model|is not available'

set_state COMPACT_SUBMITTED "driver started"
log "armed pane=$PANE sid=$SID baseline=$BASELINE label=${LABEL:-(none)} attempt=$ATTEMPT"
# yield-valve: a session whose Stop hook always blocks never goes idle, so the
# queued /compact would never drain. Contract: the driver raises this flag; a
# cooperating Stop hook sees it, deletes it, and lets ONE stop through.
touch "$YIELD"

# ---- wait for the compaction (transcript truth) -----------------------------
# The queued /compact drains when the running turn ends — which may be a long
# time if the session keeps working. Wait as long as the TUI is alive (up to
# 90 min), heartbeating the state so the guard keeps trusting the in-flight
# phase. Compaction done = a compact_boundary record appended after the arm
# offset; fallback = "Compacting" was seen on screen and the TUI went idle.
compact_seen=0; ok=0; t0=$(date +%s); hb=$t0; fails0="$FAILS0"   # baseline counted by the CLI before the Enter
while [ $(( $(date +%s) - t0 )) -lt 5400 ]; do
  alive COMPACT_DONE
  [ "$(tx_after "$TRANSCRIPT" "$OFF_ARM" compact)" = "1" ] && { ok=1; break; }
  if screen_has 'Compacting' 15; then compact_seen=1
  elif [ "$compact_seen" -eq 1 ] && wait_idle 10; then ok=2; break; fi
  [ "$(screen_count "$COMPACT_FAIL_RE" 40)" -gt "$fails0" ] \
    && fail COMPACT_DONE "compaction did not happen: $(norm | tail -40 | grep -E "$COMPACT_FAIL_RE" | tail -1)"
  if [ $(( $(date +%s) - hb )) -ge 60 ]; then set_state COMPACT_SUBMITTED "waiting for turn end + compaction ($(( ($(date +%s) - t0) / 60 ))m)"; hb=$(date +%s); fi
  sleep 2
done
[ "$ok" -ne 0 ] || fail COMPACT_DONE "no compaction after 90 min (turn never ended, or /compact was dropped)"
set_state COMPACT_DONE "$([ "$ok" -eq 1 ] && echo 'transcript compact_boundary' || echo 'screen: Compacting seen, then idle')"
log "compaction finished ($([ "$ok" -eq 1 ] && echo transcript || echo screen)) → waiting for the TUI to settle"
# post-compaction the TUI re-renders and runs SessionStart(compact) hooks
wait_idle 600; rc=$?
[ "$rc" -eq 2 ] && fail COMPACT_DONE "pane/TUI gone while settling"
[ "$rc" -eq 1 ] && fail COMPACT_DONE "TUI still busy 10 min after compaction ($(norm | tail -15 | grep -vE '^\s*$' | tail -3 | tr '\n' '|'))"

# ---- stage + submit /model <baseline> ---------------------------------------
# Staged via bracketed paste (single event — the command palette opened by the
# leading "/" cannot swallow same-tick characters), verified, then submitted.
CMD="/model $BASELINE"
stage_exact "$CMD" || fail SWITCH_SUBMITTED "could not stage '$CMD' in the input box (box: '$(box)')"
ok0="$(screen_count "$SWITCH_OK_RE" 25)"; err0="$(screen_count "$SWITCH_ERR_RE" 25)"
printf '%s %s\n' "$(date +%s)" "$CMD" >> "$(dirname "$STATE")/model-sends-$SID"   # cc-self typed it: a switch, not a declaration (guard reads this)
"$TMUX_BIN" send-keys -t "$PANE" Enter
set_state SWITCH_SUBMITTED
# Outcomes, observed rather than assumed:
#  (a) "Switch model?" confirm dialog — appears only when a warm prompt cache
#      would be invalidated; compaction acks that, so post-compaction switches
#      are normally dialog-free. Approve only after SEEING "Yes, switch to"
#      highlighted; move the cursor if "No, go back" is.
#  (b) "Set model to …" / "Kept model as …" — switched directly.
#  (c) the box still holds the command — the Enter was swallowed; retry once.
#  (d) an error line — hard failure with the screen dumped.
outcome=""; enters=1; t0=$(date +%s)
while [ $(( $(date +%s) - t0 )) -lt 30 ]; do
  s="$(norm)"
  if printf '%s\n' "$s" | grep -q 'Switch model?'; then
    if printf '%s\n' "$s" | grep -qE '❯ *([0-9]+\. )?Yes, switch to'; then
      "$TMUX_BIN" send-keys -t "$PANE" Enter; outcome=dialog; break
    elif printf '%s\n' "$s" | grep -qE '❯ *([0-9]+\. )?No, go back'; then
      "$TMUX_BIN" send-keys -t "$PANE" Up; sleep 0.5; continue
    fi
  elif [ "$(printf '%s\n' "$s" | tail -25 | grep -cE "$SWITCH_OK_RE")" -gt "$ok0" ]; then
    outcome=direct; break
  elif [ "$(printf '%s\n' "$s" | tail -25 | grep -cE "$SWITCH_ERR_RE")" -gt "$err0" ]; then
    fail SWITCH_SUBMITTED "TUI rejected the switch: $(printf '%s\n' "$s" | tail -25 | grep -E "$SWITCH_ERR_RE" | tail -1)"
  elif box_holds "$CMD" && [ $(( $(date +%s) - t0 )) -ge 4 ] && [ "$enters" -lt 2 ]; then
    log "Enter did not submit $CMD — retrying once"; "$TMUX_BIN" send-keys -t "$PANE" Enter; enters=$((enters+1))
  fi
  sleep 1
done
if [ "$outcome" = "dialog" ]; then
  # the Enter must CLOSE the dialog: typing into a still-open dialog is
  # dangerous (digits select options), so a dialog that never closes is a
  # hard failure, not something to type past
  closed=0
  for _ in $(seq 1 15); do screen_has 'Switch model\?' 30 || { closed=1; break; }; sleep 1; done
  [ "$closed" -eq 1 ] || fail SWITCHED "dialog did not close after Enter"
elif [ -z "$outcome" ]; then
  if dialog_open; then
    "$TMUX_BIN" send-keys -t "$PANE" Escape   # a dialog IS open — Escape only cancels it
    fail SWITCH_SUBMITTED "an unrecognized dialog is open after /model"
  fi
  box_holds "$CMD" && fail SWITCH_SUBMITTED "the box still holds '$(box)' — /model was not accepted"
  # no dialog, no message, box empty: the switch may simply have rendered
  # nothing recognizable. Not a failure — the transcript verdict below is the
  # truth, and the guard escalates if it did not take.
  outcome=unconfirmed
fi
# Advisory only (user statuslines vary): note whether the label happens to show
adv="unconfirmed"; sleep 1
[ -n "$LABEL" ] && screen_has "\\[$LABEL\\]" 8 && adv="statusline shows [$LABEL]"
set_state SWITCHED "switch $outcome; $adv"
log "switch submitted ($outcome; $adv)"

# ---- wake the session, then verify against the TRANSCRIPT (truth source) ---
# The switch's real effect is the model of the NEXT turn. The transcript
# records message.model on every assistant message — the same truth source the
# guard hook reads, independent of any UI configuration.
alive VERIFY_WAKE
wait_idle 120; rc=$?
[ "$rc" -eq 2 ] && fail VERIFY_WAKE "pane/TUI gone before the wake"
[ "$rc" -eq 1 ] && fail VERIFY_WAKE "TUI still busy 2 min after the switch — wake not sent ($(convo | sed '/^[[:space:]]*$/d' | tail -2 | tr '\n' '|'))"
OFF0="$(wc -c < "$TRANSCRIPT" 2>/dev/null | tr -d ' ')"; [ -n "$OFF0" ] || OFF0=0
set_state VERIFY_WAKE
WAKE="[cc-self recover] attempt $ATTEMPT: model switched, verify guard silence and report"
stage_exact "$WAKE" || fail VERIFY_WAKE "could not stage the wake message (box: '$(box)')"
submit "$WAKE" || fail VERIFY_WAKE "wake message did not submit (box: '$(box)')"
BASE="${BASELINE%%\[*}"
verdict=""
for _ in $(seq 1 150); do   # up to 5 min for the wake turn's first assistant message
  m="$(tx_after "$TRANSCRIPT" "$OFF0" model)"
  [ -n "$m" ] && { verdict="$m"; break; }
  sleep 2
done
if [ -z "$verdict" ]; then
  # Inconclusive (no new assistant message seen — python3 missing, or a very
  # slow first turn). NOT a failure: the guard hook reads the same truth on
  # the wake turn and re-arms with attempt+1 if it re-fell.
  set_state DONE "wake sent; transcript verification inconclusive — cross-check a post-wake record before re-arming"
  log "done — wake sent, transcript verification inconclusive"
elif same_model "$BASE" "$verdict"; then
  set_state DONE "verified: live model $verdict = baseline"
  log "done — verified live model $verdict"
else
  # Switch did not take or the session re-fell immediately. Terminal DONE (the
  # wake was sent); the guard sees the off-baseline transcript on that very
  # turn and escalates with attempt+1 and a stronger-abstraction instruction.
  set_state DONE "re-fell: live model $verdict != baseline $BASE — guard escalates"
  log "done — but live model is $verdict, not $BASE (guard will escalate)"
fi
finish
RCV
    chmod +x "$RDRIVER.tmp" && mv "$RDRIVER.tmp" "$RDRIVER"   # never rewrite a helper in place: a running instance reads it incrementally
    detach "/bin/bash $(shq "$RDRIVER") $(shq "$PANE") $(shq "$SID") $(shq "$BASELINE") $(shq "$LABEL") $(shq "$ATTEMPT") $(shq "$TMUX_BIN") $(shq "$STATE") $(shq "$TRANSCRIPT") $(shq "$OFF_ARM") $(shq "$PY_BIN") $(shq "$LIB") $(shq "$FAILS0")"
    logit "recover: armed sid=$SID baseline=$BASELINE label=${LABEL:-?} attempt=$ATTEMPT compact=${PASTE_BYTES}B"
    echo "recover armed (attempt $ATTEMPT): /compact submitted (${PASTE_BYTES}B) — end the turn now and do NOTHING else for this recovery (no /model, no /compact, no wake: the driver does all of it). Driver: compaction → /model $BASELINE → dialog if any → wake → transcript-verify. State: $STATE (cc-self recover --status), log: $LOG"
    ;;
  restart)
    # The session's own death kills its Bash tool too, so the restart
    # sequence is delegated to a process owned by the tmux server
    # (run-shell -b), which outlives the session.
    SID=""; FORCE=0
    while :; do
      case "${1:-}" in
        --force) FORCE=1; shift ;;
        --) break ;;
        -*) echo "cc-self restart: unknown option $1"; exit 1 ;;
        '') break ;;
        *) [ -z "$SID" ] || { echo "cc-self restart: unexpected argument $1"; exit 1; }; SID="$1"; shift ;;
      esac
    done
    [ -n "$SID" ] || SID="$(resolve_sid)"
    [ -n "$SID" ] || { echo "cc-self restart: cannot resolve session id (pass it explicitly)"; exit 1; }
    EXTRA=""
    if [ "${1:-}" = "--" ]; then shift; EXTRA="$*"; fi
    if d="$(inflight_driver "$SID")"; then
      if [ "$FORCE" -eq 1 ]; then pid="${d##* }"; job_alive "$pid" && kill "$pid" 2>/dev/null; logit "restart: superseding in-flight driver ($d) by --force"
      else echo "cc-self restart: a ${d%% *} driver is already in flight for sid=$SID (${d#* }) — not arming; --force supersedes it." >&2; exit 2; fi
    fi
    CLAUDE_BIN="${CC_SELF_CLAUDE_BIN:-}"
    if [ -z "$CLAUDE_BIN" ]; then
      CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"
      case "$CLAUDE_BIN" in ''|alias*) CLAUDE_BIN="$HOME/.local/bin/claude" ;; esac
    fi
    [ -x "$CLAUDE_BIN" ] || { echo "cc-self restart: claude binary not found: $CLAUDE_BIN"; exit 1; }
    # Capture the session's model + effort while it is still alive: a bare
    # --resume falls back to defaults, so an effort changed mid-session is
    # lost and the changed system prompt breaks the warm prompt cache.
    # Freshest source is the transcript's last main-chain assistant entry
    # (real JSON keys are unescaped there; quotes inside message text are
    # \"-escaped, so these greps can't match prose). Fallback: settings.json.
    TRANSCRIPT="$(find_transcript "$SID")"
    MODEL=""; EFFORT=""
    if [ -n "$TRANSCRIPT" ] && [ -f "$TRANSCRIPT" ]; then
      ALINE="$(grep '"type":"assistant"' "$TRANSCRIPT" | grep -v '"isSidechain":true' | grep '"effort":"' | tail -1)"
      MODEL="$(printf '%s' "$ALINE" | grep -o '"model":"[^"]*"' | head -1 | cut -d'"' -f4)"
      EFFORT="$(printf '%s' "$ALINE" | grep -o '"effort":"[a-z]*"' | head -1 | cut -d'"' -f4)"
    fi
    SETTINGS="$HOME/.claude/settings.json"
    if is_self; then SMODEL="$(baseline_model)"; else SMODEL="$(settings_model)"; fi
    # transcripts record the bare API model id; settings may name a suffixed
    # variant of the same model (e.g. claude-fable-5[1m] for 1M context).
    # Adopt the suffixed form when the base matches so the mode survives.
    if [ -n "$MODEL" ] && [ "${SMODEL%%\[*}" = "$MODEL" ]; then MODEL="$SMODEL"; fi
    [ -n "$MODEL" ]  || MODEL="$SMODEL"
    [ -n "$EFFORT" ] || EFFORT="$(grep -o '"effortLevel"[[:space:]]*:[[:space:]]*"[^"]*"' "$SETTINGS" 2>/dev/null | head -1 | cut -d'"' -f4)"
    # cc-self's per-session declarations live in the session's environment,
    # which the relaunch (typed into the pane's shell) would not inherit:
    # carry them as an assignment prefix on the resume command (self only —
    # for --pane targets our environment says nothing about that session).
    ENVPFX=""
    if is_self; then
      for v in CC_SELF_BASELINE CC_SELF_GUARD_DISABLED; do
        [ -n "${!v:-}" ] && ENVPFX="$ENVPFX$v=$(shq "${!v}") "
      done
    fi
    RSTATE="$STATE_DIR/restart-$SID.json"
    printf '{"sid":"%s","pane":"%s","phase":"ARMED","note":"","pid":0,"ts":"%s"}\n' "$SID" "$PANE" "$(date '+%FT%T%z')" > "$RSTATE"
    DRIVER="$HOME/.cc-self-restart-driver.sh"
    cat > "$DRIVER.tmp" <<'DRV'
#!/bin/bash
# cc-self restart driver — runs detached under the tmux server. Always exits 0
# (a non-zero exit of a run-shell -b job is echoed by tmux as a view-mode
# overlay on the focused pane); outcomes live in the log and the state file.
PANE="$1"; SID="$2"; BIN="$3"; TMUX_BIN="$4"; MODEL="$5"; EFFORT="$6"; EXTRA="$7"; RSTATE="$8"; LIB="$9"; ENVPFX="${10:-}"
[ -n "$PANE" ] && [ -n "$TMUX_BIN" ] && [ -f "$LIB" ] && [ -n "$RSTATE" ] || { echo "cc-self restart driver: missing PANE/TMUX_BIN/LIB/RSTATE — refusing to run" >&2; exit 0; }
export PANE TMUX_BIN LOGTAG=restart-driver
# shellcheck disable=SC1090  # generated by scripts/cc-self
. "$LIB" || exit 0
set_state() {
  local n; n="$(printf '%s' "${2:-}" | tr '\042\134\n' '\047  ')"
  printf '{"sid":"%s","pane":"%s","phase":"%s","note":"%s","pid":%s,"ts":"%s"}\n' "$SID" "$PANE" "$1" "$n" "$$" "$(date '+%FT%T%z')" > "$RSTATE.$$.tmp" && mv "$RSTATE.$$.tmp" "$RSTATE"
}
fail() { log "FAIL $1${2:+: $2}"; set_state "FAILED-$1" "${2:-}"; exit 0; }
tui_gone() { ! tui_alive; }   # claude exited = no claude process left in the pane's tree

set_state WAIT_TURN "driver started"
log "start pane=$PANE sid=$SID"
sleep 10                              # let the session finish its last message
wait_idle 1800; rc=$?                 # wait for the turn to end (max 30 min)
[ "$rc" -eq 2 ] && fail WAIT_TURN "pane/TUI gone"
[ "$rc" -eq 1 ] && fail WAIT_TURN "turn still busy after 30 min — session left intact"
# preserve session state across the relaunch: pin the model + effort captured
# at arm time (a bare --resume falls back to defaults — effort resets and the
# changed system prompt breaks the warm prompt cache), keep the bypass flag
# only if the footer showed it on, and append caller extras. An extra that
# names --model/--effort itself replaces the pinned one (pin is dropped).
# Every typed value is single-quoted: the command lands in the pane's live
# shell, where an unquoted claude-fable-5[1m] is a zsh glob ("no matches
# found" — the relaunch never runs).
case " $EXTRA" in *" --model"*)  MODEL=""  ;; esac
case " $EXTRA" in *" --effort"*) EFFORT="" ;; esac
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
FLAGS=""
[ -n "$MODEL" ]  && FLAGS="$FLAGS --model $(shq "$MODEL")"
[ -n "$EFFORT" ] && FLAGS="$FLAGS --effort $(shq "$EFFORT")"
norm | grep -q 'bypass permissions on' && FLAGS="$FLAGS --dangerously-skip-permissions"
if [ -n "$EXTRA" ]; then
  read -ra EXTRA_WORDS <<< "$EXTRA"
  for w in "${EXTRA_WORDS[@]}"; do FLAGS="$FLAGS $(shq "$w")"; done
fi
log "turn idle → sending /exit (resume flags:${FLAGS:- none})"
set_state EXIT
# /exit is staged (bracketed paste, verified in the box), never typed blind:
# at idle the leading "/" opens the command palette, which can swallow
# same-tick characters (a live incident submitted the stray remainder as a
# fake user message).
stage_exact '/exit' || fail EXIT "could not stage /exit — session left intact (box: '$(box)')"
submit '/exit' || fail EXIT "Enter did not submit /exit — session left intact"
# /exit with live background tasks opens a "Background work is running"
# confirm dialog instead of exiting — Enter takes the preselected
# "Exit and stop tasks" (restart kills background work by contract).
for _ in $(seq 1 90); do
  tui_gone && break
  if norm | grep -q 'Background work is running'; then
    log "background-work dialog → confirming (exit and stop tasks)"
    "$TMUX_BIN" send-keys -t "$PANE" Enter
  fi
  sleep 1
done
tui_gone || fail EXIT "claude did not exit (fg=$(fg))"
log "claude exited → relaunching (real binary, alias bypassed${ENVPFX:+; env: $ENVPFX})"
set_state RELAUNCH
sleep 1
"$TMUX_BIN" send-keys -t "$PANE" -l -- "$ENVPFX$(shq "$BIN") --resume $SID$FLAGS"
sleep 0.5
"$TMUX_BIN" send-keys -t "$PANE" Enter
for _ in $(seq 1 60); do tui_gone || break; sleep 1; done
tui_gone && fail RELAUNCH "claude did not come back"
log "claude relaunched → waiting for session load"
set_state WAKE
wait_idle 300; rc=$?
[ "$rc" -eq 0 ] || fail WAKE "resumed session did not settle (rc=$rc)"
WAKE='[cc-self restart driver] Automated restart sequence complete. Verify session continuity and report the result to the user.'
if stage_exact "$WAKE" && submit "$WAKE"; then
  set_state DONE "resumed and woken"
  log "wake-up message sent — driver done"
else
  fail WAKE "could not stage/submit the wake message (box: '$(box)')"
fi
exit 0
DRV
    chmod +x "$DRIVER.tmp" && mv "$DRIVER.tmp" "$DRIVER"   # never rewrite a helper in place
    detach "/bin/bash $(shq "$DRIVER") $(shq "$PANE") $(shq "$SID") $(shq "$CLAUDE_BIN") $(shq "$TMUX_BIN") $(shq "$MODEL") $(shq "$EFFORT") $(shq "$EXTRA") $(shq "$RSTATE") $(shq "$LIB") $(shq "$ENVPFX")"
    logit "restart: sid=$SID bin=$CLAUDE_BIN model=${MODEL:-?} effort=${EFFORT:-?}${EXTRA:+ extra=$EXTRA}${ENVPFX:+ env=$ENVPFX}"
    echo "restart driver armed — after this turn ends: /exit → resume pinning model=${MODEL:-default} effort=${EFFORT:-default}${EXTRA:+ + $EXTRA} (state: $RSTATE, log: $LOG)"
    ;;
  *)
    usage
    ;;
esac
